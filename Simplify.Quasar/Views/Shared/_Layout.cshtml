@using System.Web.Optimization
@using WebHelpers.Mvc5.Enum
@{
    var assemblyVersion = typeof(Simplify.Quasar.Controllers.AccountController).Assembly.GetName().Version;
    var applicationVersion = string.Format(
        "{0}.{1}.{2}",
        assemblyVersion.Major,
        assemblyVersion.Minor,
        assemblyVersion.Build);
    var sidebarMenuContext = string.Equals(
        Convert.ToString(ViewContext.RouteData.Values["controller"]),
        "Locacao",
        StringComparison.OrdinalIgnoreCase)
        ? "Locacao"
        : string.Empty;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>
        Quasar Dealer
    </title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    @*<link href="@Url.Content("~/Content/img/quasar.png")" rel="shortcut icon" type="image/x-icon" />*@
    @Styles.Render("~/Bundles/css")
    <link href="@Url.Content("~/Content/Quasar.DeliveryPreview.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/img/quasar-dealer-favicon.ico")" rel="shortcut icon" type="image/x-icon" />
    <style>
        .main-sidebar .sidebar-login-thumb {
            display: none;
        }
    </style>
</head>

<body class="hold-transition skin-purple sidebar-mini quasar-modern quasar-delivery-preview">
    <div class="wrapper" style="height: auto; min-height: 100%;">
        <header class="main-header">
            <a href="#" class="logo" style="pointer-events:none;">
                <span class="logo-lg"><img src="@Url.Content("~/Content/img/quasar-dealer-logo.svg")" alt="Quasar Dealer" /></span>
            </a>
            <nav class="navbar navbar-static-top" role="navigation">
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                    <span class="sr-only">Toggle navigation</span>
                </a>
                <div class="nav navbar-nav navbar-title hidden-xs">
                    <span>AUTOMEC CHEVROLET<small>&nbsp;&nbsp;&nbsp;@(Session["filialnome"] != null ? Session["filialnome"].ToString() : string.Empty)</small></span>
                    @if (Simplify.Quasar.Custom.Util.IsTestEnvironment())
                    {
                        <span class="alert alert-warning">
                            The application is running in a test environment
                        </span>
                    }
                </div>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        <li>
                            <a href="@Url.Action("Index", "Manual", new { area = "" })"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Abrir o manual do sistema">
                                <i class="fa fa-book"></i>
                                <span class="hidden-xs"> Manual</span>
                            </a>
                        </li>
                        <li class="dropdown user user-menu">
                            <a href="@Url.Action("Index","Home", new { area = "Admin"})" class="dropdown-toggle" data-toggle="dropdown">
                                <img src="~/Content/img/Avatar.PNG" class="user-image" alt="User Image">
                                <span class="hidden-xs">
                                    @(Session["displayname"] != null ? Session["displayname"].ToString() : string.Empty)
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Logout","Account", new { area = ""})" title="Log out"><i class="fa fa-sign-out"></i> Logout</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        @Html.Action("Index", "Menu", new { menuContext = sidebarMenuContext })

        <div class="content-wrapper">
            @RenderBody()
        </div>
        <footer class="main-footer">
            <div class="footer-shell">
                <div class="row">
                    <div class="col-sm-7">
                        <span class="footer-kicker">Quasar Dealer</span>
                        <div style="margin-top:6px;">
                            Versão @applicationVersion
                        </div>
                    </div>
                    <div class="col-sm-5 footer-meta">
                        <div><strong>Powered by</strong> <a href="https://simplifyse.com.br" target="_blank">Simplify IT</a></div>
                        <div style="margin-top:6px;">@DateTime.Now.Year &middot; Quasar Dealer</div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://kit.fontawesome.com/d4c8df1d3e.js" crossorigin="anonymous"></script>

    <script src="@RouteJs.RouteJsHandler.HandlerUrl"></script>
    <script src="@EnumHandler.HandlerUrl"></script>

    @Scripts.Render("~/Bundles/jquery")
    @Scripts.Render("~/Bundles/bootstrap")
    @Scripts.Render("~/Bundles/js")
    @Scripts.Render("~/Bundles/adminlte")

    @RenderSection("ViewSpecificJavascript", required: false)
    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {
            var url = window.location;

            $('ul.sidebar-menu a').filter(function () {
                return this.href == url;
            }).parent().addClass('active');

            $('ul.treeview-menu a').filter(function () {
                return this.href == url;
            }).parentsUntil(".sidebar-menu > .treeview-menu").addClass('active')
        })
    </script>
    @Html.Partial("~/Views/Shared/_ActivityTracker.cshtml")
</body>
</html>
