
@using System.Web.Optimization
@using WebHelpers.Mvc5.Enum

<!DOCTYPE html>

<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#eee"> <!-- Cor do tema -->
    @*<title>Quasar.Dealer</title>*@
    @Styles.Render("~/Bundles/css")

    @*<link rel="stylesheet" href="styles.css">*@
    <style>
        .header-coletor {
            text-align: center;
            padding: 5px;
        }
    </style>
</head>
<body>

    <header>
        <h1 class="header-coletor">Quasar.Dealer</h1>
        <h5 class="header-coletor">Armazenagem de Peças</h5>
    </header>

    <main>

        <div class="container-fluid">
            @RenderBody()
        </div>

    </main>

    <script src="https://kit.fontawesome.com/d4c8df1d3e.js" crossorigin="anonymous"></script>


    <script src="@RouteJs.RouteJsHandler.HandlerUrl"></script>
    <script src="@EnumHandler.HandlerUrl"></script>

    @Scripts.Render("~/Bundles/jquery")
    @Scripts.Render("~/Bundles/bootstrap")
    @Scripts.Render("~/Bundles/js")
    @*@Scripts.Render("~/Bundles/adminlte")*@


    @RenderSection("ViewSpecificJavascript", required: false)
    @RenderSection("scripts", required: false)
    @Html.Partial("~/Views/Shared/_ActivityTracker.cshtml")

</body>
</html>
























