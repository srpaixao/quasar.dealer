@{
    Layout = null;
    ViewBag.Title = "Relatório de Teste";
}

@using System.Web.Optimization
@using WebHelpers.Mvc5.Enum

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>
        Quasar Dealer
    </title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    @Styles.Render("~/Bundles/css")
</head>

<body class="hold-transition skin-purple sidebar-mini">
    <div class="wrapper" style="height: auto; min-height: 100%;">
        <header class="main-header">
            <a href="#" class="logo" style="pointer-events:none;">
                <span class="logo-lg"><b>Quasar.</b>Dealer</span>
            </a>
            <nav class="navbar navbar-static-top" role="navigation">
                <div class="nav navbar-nav navbar-title hidden-xs">
                    <span>AUTOMEC CHEVROLET<small>&nbsp;&nbsp;&nbsp;@(Session["filialnome"] != null ? Session["filialnome"].ToString() : string.Empty)</small></span>
                    @if (Simplify.Quasar.Custom.Util.IsTestEnvironment())
                    {
                        <span class="alert alert-warning">
                            The application is running in a test environment
                        </span>
                    }
                </div>
            </nav>
        </header>

        <div class="content-wrapper" style="margin-left:0px">
            <div class="row">
                <div class="col-xs-12" style="margin-left:15px">
                    <h4>Relatórios de Teste</h4>

                    <!-- Botão que abre o PDF em nova guia -->

                    <a href="@Url.Action("RomaneioEntrega", "Report")" target="_blank" class="btn btn-primary">
                        Romaneio
                    </a>

                    <a href="@Url.Action("Teste1", "Report")" target="_blank" class="btn btn-primary">
                        Report 1
                    </a>

                    <a href="@Url.Action("Teste2", "Report")" target="_blank" class="btn btn-primary">
                        Report 2
                    </a>

                    <a href="@Url.Action("Teste3", "Report")" target="_blank" class="btn btn-primary">
                        Report 3
                    </a>

                </div>
            </div>
        </div>
    </div>

    <footer style="padding-top:5px;padding-bottom:5px">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-6">
                    <span class="hidden-xs">Powered by <a href="https://simplifyse.com.br" target="_blank">Simplify IT</a></span>
                </div>
                <div class="col-xs-6 hidden-xs">
                    <small class="pull-right"><strong>Copyright © 2014-2019 <a href="https://adminlte.io">AdminLTE</a>.</strong> All rights reserved. <b>  Version</b> 2.4.13</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://kit.fontawesome.com/d4c8df1d3e.js" crossorigin="anonymous"></script>

    <script src="@RouteJs.RouteJsHandler.HandlerUrl"></script>
    <script src="@EnumHandler.HandlerUrl"></script>

    @Scripts.Render("~/Bundles/jquery")
    @Scripts.Render("~/Bundles/bootstrap")
    @Scripts.Render("~/Bundles/js")
    @Scripts.Render("~/Bundles/adminlte")

</body>
</html>
