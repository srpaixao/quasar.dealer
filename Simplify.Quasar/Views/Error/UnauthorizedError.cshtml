@{
    ViewBag.Title = "Acesso n\u00E3o autorizado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>Acesso n&atilde;o autorizado</h1>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-danger">
                <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-ban"></i> Permiss&atilde;o negada</h3>
                </div>
                <div class="box-body">
                    <p style="font-size:16px; margin-bottom:18px;">
                        @Html.Raw(ViewBag.Message ?? "Acesso n&atilde;o autorizado. Seu perfil n&atilde;o possui permiss&atilde;o para acessar esta funcionalidade.")
                    </p>
                    <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">
                        <i class="fa fa-home"></i> Voltar para a p&aacute;gina inicial
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
