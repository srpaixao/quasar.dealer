@model IEnumerable<Simplify.Quasar.ViewModels.MenuViewModel>
<aside class="main-sidebar">
    <section class="sidebar">
        <ul class="sidebar-menu tree" data-widget="tree">

            <li class="header text-center menu-sidebar">
                <a href="#" style="pointer-events:none;"><i class="fa-solid fa-house"></i> Painel Principal</a>
            </li>

            @foreach (var item in Model)
            {
                if (item._menu.Count == 0)
                {
                    <li>
                        <a href="@Url.Action(item.Action, item.Controller, new { area=item.Area})">
                            <i class="@item.Css"></i><span>&nbsp;&nbsp;@item.Titulo</span>
                            @*@if (item.Action == "ConferenciaVolume")
                            {
                                <span class="pull-right-container" style="top:40%">
                                    <small class="label pull-right bg-orange-active">@ViewBag.TotalVolumes</small>
                                </span>
                            }*@
                        </a>
                    </li>
                }
                else
                {
                    <li class="treeview">
                        <a href="#">
                            <i class="@item.Css"></i>
                            <span>&nbsp;&nbsp;@item.Titulo</span>
                            <span class="pull-right-container">
                                <i class="fa-solid fa-caret-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            @foreach (var sub in item._menu)
                            {
                                <li>
                                    <a href="@Url.Action(sub.Action, sub.Controller, new { area=sub.Area})">
                                        <i class="@sub.Css"></i><span>&nbsp;&nbsp;@sub.Titulo</span>
                                        @*@if (sub.Action == "ConferenciaVolume")
                                        {
                                            <span class="pull-right-container" style="top:40%">
                                                <small class="label pull-right bg-orange-active">@ViewBag.TotalVolumes</small>
                                            </span>
                                        }*@
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
        <div class="sidebar-login-thumb">
            <span class="sidebar-login-thumb__image"></span>
        </div>

    </section>
</aside>
