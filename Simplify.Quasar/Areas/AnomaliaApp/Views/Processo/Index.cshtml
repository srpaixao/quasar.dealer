@model Simplify.Quasar.Areas.AnomaliaApp.ViewModels.AnomaliaConsultaPageViewModel
@using System.Linq
@{
    ViewBag.Title = "Consultar Anomalias";
    ViewBag.Description = "GM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header"><h1>@ViewBag.Title <small>@ViewBag.Description</small></h1></section>
<section class="content">
    <div class="box box-default">
        <div class="box-header with-border">
            <a class="btn btn-primary" href="@Url.Action("Create")"><i class="fa fa-plus"></i> Nova</a>
        </div>
        <div class="box-body">
            <form method="get">
                <div class="row">
                    <div class="col-md-4 form-group"><label>Controle Nr</label><input name="numeroControle" value="@Model.NumeroControle" class="form-control" /></div>
                    <div class="col-md-3 form-group"><label>Tipo</label><select name="tipo" class="form-control"><option value="">Todos</option><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="G">G</option></select></div>
                    <div class="col-md-3 form-group"><label>Status</label><select name="statusId" class="form-control"><option value="">Todos</option><option value="1">Em processo</option><option value="4">Finalizado</option></select></div>
                    <div class="col-md-2 form-group"><label>&nbsp;</label><button class="btn btn-info btn-block"><i class="fa fa-search"></i> Filtrar</button></div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-condensed table-bordered table-hover">
                    <thead><tr><th>Controle</th><th>Data</th><th>Tipos</th><th>Itens</th><th>Em processo</th><th>Aceitos</th><th>Rejeitados</th><th>Status</th><th>Criado por</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.Processos) {
                        <tr><td><b>@p.NumeroControle</b></td><td>@p.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td><td>@p.Tipos</td><td>@p.QuantidadeItens</td><td>@p.EmProcesso</td><td>@p.Aceitos</td><td>@p.Rejeitados</td><td><span class="label @(p.EmProcesso > 0 ? "label-warning" : "label-success")">@p.StatusDescricao</span></td><td>@p.CriadoPor</td><td><a class="btn btn-xs btn-info" href="@Url.Action("Detalhe", new { id = p.Id })"><i class="fa fa-search"></i> Detalhes</a></td></tr>
                    }
                    @if (!Model.Processos.Any()) { <tr><td colspan="10" class="text-center" style="padding:25px;">Nenhum processo localizado.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section scripts {
<script>
$(function () {
    $('select[name="tipo"]').val('@Model.Tipo');
    $('select[name="statusId"]').val('@(Model.StatusId.HasValue ? Model.StatusId.Value.ToString() : "")');
});
</script>
}
