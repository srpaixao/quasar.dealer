@{
    ViewBag.Title = "Cadastrar Anomalia";
    ViewBag.Description = "GM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .anomalia-search-box { max-width: 720px; }
    .anomalia-summary { background: #f4f8fb; border: 1px solid #d9e5ed; border-radius: 6px; padding: 12px; margin-bottom: 15px; }
    .anomalia-summary strong { color: #12304d; }
    .anomalia-empty { padding: 28px !important; color: #6f7f8f; }
    .anomalia-modal-warning { display: none; margin-bottom: 12px; }
    .anomalia-item-header { display: none; margin-top: 20px; margin-bottom: 10px; padding: 12px 15px; background: #edf7fc; border-left: 4px solid #3c8dbc; }
    .anomalia-item-header__code { font-size: 18px; font-weight: 700; color: #12304d; }
    .anomalia-item-header__description { color: #52697d; margin-left: 12px; }
    #tbOcorrencias td, #tbItensAnomalia td { vertical-align: middle; }
</style>

<section class="content-header">
    <h1>@ViewBag.Title <small>@ViewBag.Description</small></h1>
</section>

<section class="content">
    @Html.AntiForgeryToken()

    <div class="box box-default">
        <div class="box-header with-border">
            <h3 class="box-title"><i class="fa fa-search text-blue"></i> Localizar item faturado</h3>
        </div>
        <div class="box-body">
            <p class="text-muted">Informe o Item Nr. O sistema listará todas as notas fiscais e volumes da filial atual.</p>
            <div class="input-group anomalia-search-box">
                <input id="termoItem" type="text" class="form-control" placeholder="Item Nr" autocomplete="off" />
                <span class="input-group-btn">
                    <button id="btnPesquisar" type="button" class="btn btn-primary">
                        <i class="fa fa-search"></i> Pesquisar
                    </button>
                </span>
            </div>

            <div id="cabecalhoItem" class="anomalia-item-header">
                <span class="anomalia-item-header__code" id="cabecalhoItemNr"></span>
                <span class="anomalia-item-header__description" id="cabecalhoDescricao"></span>
            </div>
            <div class="table-responsive">
                <table class="table table-condensed table-bordered table-hover" id="tbOcorrencias">
                    <thead>
                        <tr><th>NF</th><th>Data emissão</th><th>Volume</th><th>Quantidade NF</th><th>Saldo disponível</th><th>Prazo / situação</th><th style="width:110px;"></th></tr>
                    </thead>
                    <tbody><tr><td colspan="7" class="text-center anomalia-empty">Informe um item para iniciar a pesquisa.</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="box box-default">
        <div class="box-header with-border">
            <h3 class="box-title"><i class="fa fa-exclamation-triangle text-yellow"></i> Itens da Anomalia</h3>
        </div>
        <div class="box-body">
            <div class="table-responsive">
                <table class="table table-condensed table-bordered table-hover" id="tbItensAnomalia">
                    <thead>
                        <tr><th>Tipo</th><th>NF</th><th>Volume</th><th>Item</th><th>Descrição</th><th>Qtd. NF</th><th>Saldo disponível</th><th>Qtd. reclamada</th><th>Data limite</th><th>Observação</th><th style="width:50px;"></th></tr>
                    </thead>
                    <tbody><tr><td colspan="11" class="text-center anomalia-empty">Nenhum item selecionado.</td></tr></tbody>
                </table>
            </div>

            <div class="form-group">
                <label for="observacaoProcesso">Observações do processo</label>
                <textarea id="observacaoProcesso" class="form-control" rows="3" maxlength="1000"></textarea>
            </div>
        </div>
        <div class="box-footer text-right">
            <a class="btn btn-default" href="@Url.Action("Index")"><i class="fa fa-times"></i> Cancelar</a>
            <button id="btnFinalizar" type="button" class="btn btn-success">
                <i class="fa fa-check"></i> Finalizar Cadastro
            </button>
        </div>
    </div>
</section>

<div class="modal fade" id="modalAnomaliaItem" data-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-blue-gradient">
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
                <span class="modal-title"><i class="fa fa-plus-square fa-fw"></i>&nbsp;&nbsp;Adicionar item à Anomalia</span>
            </div>
            <div class="modal-body">
                <div id="resumoOcorrencia" class="anomalia-summary"></div>
                <div id="avisoContexto" class="alert alert-warning anomalia-modal-warning"></div>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label for="modalTipo">Tipo de Anomalia</label>
                        <select id="modalTipo" class="form-control">
                            <option value="">-- Selecione --</option>
                            <option value="A">A - Falta</option>
                            <option value="B">B - Excesso</option>
                            <option value="C">C - Item diferente</option>
                            <option value="G">G - Danificado</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Quantidade já reclamada</label>
                        <input id="modalJaReclamada" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Saldo disponível</label>
                        <input id="modalSaldo" class="form-control" readonly />
                    </div>
                </div>
                <div class="row">
                    <div id="grupoRecebida" class="col-md-4 form-group" style="display:none;">
                        <label for="modalRecebida">Quantidade efetivamente recebida</label>
                        <input id="modalRecebida" type="number" min="0" step="0.0001" class="form-control" />
                    </div>
                    <div id="grupoItemRecebido" class="col-md-4 form-group" style="display:none;">
                        <label for="modalItemRecebido">Item efetivamente recebido</label>
                        <input id="modalItemRecebido" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label for="modalQuantidade">Quantidade reclamada</label>
                        <input id="modalQuantidade" type="number" min="1" step="1" class="form-control" inputmode="numeric" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Data limite</label>
                        <input id="modalDataLimite" class="form-control" readonly />
                    </div>
                </div>
                <div id="grupoDanificado" class="row" style="display:none;">
                    <div class="col-md-4 form-group">
                        <label for="modalInstalado">Peça instalada no veículo?</label>
                        <select id="modalInstalado" class="form-control">
                            <option value="">-- Selecione --</option>
                            <option value="true">Sim</option>
                            <option value="false">Não</option>
                        </select>
                    </div>
                    <div class="col-md-8 form-group">
                        <label for="modalCondicaoEmbalagem">Condições da embalagem</label>
                        <input id="modalCondicaoEmbalagem" class="form-control" maxlength="500" />
                    </div>
                </div>
                <div class="form-group">
                    <label id="labelModalObservacao" for="modalObservacao">Observação do item</label>
                    <textarea id="modalObservacao" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa fa-times"></i> Fechar</button>
                <button id="btnAdicionarItem" type="button" class="btn btn-success" disabled><i class="fa fa-check"></i> Adicionar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
(function () {
    var ocorrencias = {};
    var selecionados = [];
    var ocorrenciaAtual = null;
    var contextoAtual = null;

    function n(v) { var x = Number(String(v == null || v === '' ? 0 : v).replace(',', '.')); return isNaN(x) ? 0 : x; }
    function fmtNumero(v) { return n(v).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 4 }); }
    function dt(v) { var m = /Date\((\d+)\)/.exec(v || ''); var d = m ? new Date(Number(m[1])) : new Date(v); return isNaN(d.getTime()) ? null : d; }
    function fmtData(v) { var d = dt(v); return d ? d.toLocaleDateString('pt-BR') : ''; }
    function esc(v) { return $('<div/>').text(v == null ? '' : v).html(); }
    function mensagem(texto, icone) {
        swal({ title: 'Cadastro de Anomalias', text: texto, icon: icone || 'error', button: { text: 'OK', className: 'swal-btn-info' } });
    }
    function falha(xhr) { mensagem(xhr.responseJSON && xhr.responseJSON.message || 'Não foi possível concluir a operação.'); }

    function pesquisar() {
        var termo = $.trim($('#termoItem').val());
        if (!termo) { mensagem('Informe o Item Nr para pesquisa.', 'warning'); return; }
        $('#btnPesquisar').prop('disabled', true);
        $.get('@Url.Action("PesquisarOcorrenciasItem")', { termo: termo }).done(function (r) {
            ocorrencias = {};
            var html = '';
            (r.data || []).forEach(function (x) {
                ocorrencias[x.NotaFiscalItemId] = x;
                var situacao;
                if (x.TodosTiposForaDoPrazo) {
                    situacao = '<span class="label label-danger">NF fora do prazo</span><br><small>Último limite: ' + fmtData(x.DataLimiteMaxima) + '</small>';
                } else if (x.DiasDecorridos > x.PrazoMinimoDias) {
                    situacao = '<span class="label label-warning">Prazo curto encerrado</span><br><small>Último limite: ' + fmtData(x.DataLimiteMaxima) + '</small>';
                } else {
                    situacao = '<span class="label label-success">Dentro do prazo</span><br><small>Próximo limite: ' + fmtData(x.DataLimiteMinima) + '</small>';
                }
                if (x.SemSaldo) situacao += '<br><span class="label label-default">Sem saldo para reclamar</span>';
                var saldos = '<span title="Saldo para A, C e G">A/C/G: <b>' + fmtNumero(x.SaldoPadrao) + '</b></span><br><span title="Excesso já conferido para B">B: <b>' + fmtNumero(x.SaldoExcesso) + '</b></span>';
                html += '<tr><td><b>' + esc(x.NotaFiscalNr) + '</b></td><td>' + fmtData(x.DataEmissao) + '</td><td>' + esc(x.VolumeNr) + '</td><td>' + fmtNumero(x.QuantidadeNF) + '</td><td>' + saldos + '</td><td>' + situacao + '</td><td><button type="button" class="btn btn-xs btn-primary selecionar" data-id="' + x.NotaFiscalItemId + '" ' + (x.TodosTiposForaDoPrazo ? 'disabled title="NF fora do prazo para todos os tipos"' : '') + '><i class="fa fa-check"></i> Selecionar</button></td></tr>';
            });
            var primeiro = (r.data || [])[0];
            $('#cabecalhoItem').toggle(!!primeiro);
            $('#cabecalhoItemNr').text(primeiro ? 'Item ' + primeiro.ItemNr : '');
            $('#cabecalhoDescricao').text(primeiro ? primeiro.Descricao : '');
            $('#tbOcorrencias tbody').html(html || '<tr><td colspan="7" class="text-center anomalia-empty">Nenhuma NF/Volume localizado para o item informado.</td></tr>');
        }).fail(falha).always(function () { $('#btnPesquisar').prop('disabled', false); });
    }

    $('#btnPesquisar').on('click', pesquisar);
    $('#termoItem').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); pesquisar(); } });

    $('#tbOcorrencias').on('click', '.selecionar', function () {
        ocorrenciaAtual = ocorrencias[$(this).data('id')];
        contextoAtual = null;
        $('#modalTipo').val('');
        $('#modalJaReclamada,#modalSaldo,#modalQuantidade,#modalItemRecebido,#modalObservacao,#modalDataLimite,#modalInstalado,#modalCondicaoEmbalagem').val('');
        $('#modalRecebida').val(ocorrenciaAtual.QuantidadeRecebida == null ? '' : ocorrenciaAtual.QuantidadeRecebida);
        $('#grupoRecebida,#grupoItemRecebido,#grupoDanificado,#avisoContexto').hide();
        $('#labelModalObservacao').text('Observação do item');
        $('#btnAdicionarItem').prop('disabled', true);
        $('#resumoOcorrencia').html('<div class="row"><div class="col-sm-3"><strong>Item</strong><br>' + esc(ocorrenciaAtual.ItemNr) + '</div><div class="col-sm-3"><strong>NF</strong><br>' + esc(ocorrenciaAtual.NotaFiscalNr) + '</div><div class="col-sm-3"><strong>Volume</strong><br>' + esc(ocorrenciaAtual.VolumeNr) + '</div><div class="col-sm-3"><strong>Quantidade NF</strong><br>' + fmtNumero(ocorrenciaAtual.QuantidadeNF) + '</div></div>');
        $('#modalAnomaliaItem').modal({ backdrop: 'static', keyboard: true }, 'show');
    });

    $('#modalTipo').on('change', function () {
        var tipo = this.value;
        contextoAtual = null;
        $('#grupoRecebida').toggle(tipo === 'B');
        $('#grupoItemRecebido').toggle(tipo === 'C');
        $('#grupoDanificado').toggle(tipo === 'G');
        $('#labelModalObservacao').text(tipo === 'G' ? 'Detalhe do defeito ou dano' : 'Observação do item');
        $('#avisoContexto').hide();
        $('#btnAdicionarItem').prop('disabled', true);
        if (!tipo || !ocorrenciaAtual) return;

        $.get('@Url.Action("ObterContextoItem")', { notaFiscalItemId: ocorrenciaAtual.NotaFiscalItemId, tipoCodigo: tipo })
            .done(function (r) {
                contextoAtual = r.data;
                var pendente = selecionados.filter(function (i) {
                    return i.NotaFiscalItemId === ocorrenciaAtual.NotaFiscalItemId && ((tipo === 'B') === (i.TipoCodigo === 'B'));
                }).reduce(function (total, i) { return total + n(i.QuantidadeReclamada); }, 0);
                contextoAtual.SaldoLocal = Math.max(0, n(contextoAtual.SaldoDisponivel) - pendente);
                $('#modalJaReclamada').val(fmtNumero(n(contextoAtual.QuantidadeJaReclamada) + pendente));
                $('#modalSaldo').val(fmtNumero(contextoAtual.SaldoLocal));
                contextoAtual.QuantidadeMaximaInteira = Math.floor(contextoAtual.SaldoLocal);
                $('#modalQuantidade').attr('max', contextoAtual.QuantidadeMaximaInteira).val(contextoAtual.QuantidadeMaximaInteira > 0 ? contextoAtual.QuantidadeMaximaInteira : '');
                $('#modalDataLimite').val(fmtData(contextoAtual.DataLimite));
                var vencido = !contextoAtual.DentroDoPrazo;
                contextoAtual.Vencido = vencido;
                if (vencido) $('#avisoContexto').text('Prazo excedido: ' + contextoAtual.DiasDecorridos + ' dia(s) desde a emissão; permitido para o tipo ' + tipo + ': ' + contextoAtual.PrazoDias + ' dia(s).').show();
                else if (tipo !== 'B' && contextoAtual.QuantidadeMaximaInteira <= 0) $('#avisoContexto').text('Não existe saldo inteiro disponível para este item e tipo de anomalia.').show();
                $('#btnAdicionarItem').prop('disabled', vencido || (tipo !== 'B' && contextoAtual.QuantidadeMaximaInteira <= 0));
                if (tipo === 'B') atualizarSaldoExcesso();
            }).fail(falha);
    });

    function atualizarSaldoExcesso() {
        if (!contextoAtual || $('#modalTipo').val() !== 'B') return;
        var pendente = selecionados.filter(function (i) { return i.NotaFiscalItemId === ocorrenciaAtual.NotaFiscalItemId && i.TipoCodigo === 'B'; })
            .reduce(function (total, i) { return total + n(i.QuantidadeReclamada); }, 0);
        var saldo = Math.max(0, n($('#modalRecebida').val()) - n(ocorrenciaAtual.QuantidadeNF) - n(contextoAtual.QuantidadeJaReclamada) - pendente);
        contextoAtual.SaldoLocal = saldo;
        contextoAtual.QuantidadeMaximaInteira = Math.floor(saldo);
        $('#modalSaldo').val(fmtNumero(saldo));
        $('#modalQuantidade').attr('max', contextoAtual.QuantidadeMaximaInteira).val(contextoAtual.QuantidadeMaximaInteira > 0 ? contextoAtual.QuantidadeMaximaInteira : '');
        var ok = contextoAtual.QuantidadeMaximaInteira > 0 && !contextoAtual.Vencido;
        $('#avisoContexto').toggle(!ok).text(contextoAtual.Vencido ? 'Prazo excedido: ' + contextoAtual.DiasDecorridos + ' dia(s) desde a emissão; permitido: ' + contextoAtual.PrazoDias + ' dia(s).' : (ok ? '' : 'A quantidade recebida deve gerar excesso disponível para reclamação.'));
        $('#btnAdicionarItem').prop('disabled', !ok);
    }
    $('#modalRecebida').on('input', atualizarSaldoExcesso);

    $('#btnAdicionarItem').on('click', function () {
        var tipo = $('#modalTipo').val(), qtd = n($('#modalQuantidade').val());
        if (!contextoAtual || qtd <= 0 || qtd % 1 !== 0 || qtd > n(contextoAtual.QuantidadeMaximaInteira)) { mensagem('Informe a quantidade reclamada em número inteiro, limitada ao saldo disponível.', 'warning'); return; }
        if (tipo === 'C' && !$.trim($('#modalItemRecebido').val())) { mensagem('Informe o item efetivamente recebido.', 'warning'); return; }
        if (tipo === 'G' && !$.trim($('#modalObservacao').val())) { mensagem('Informe o detalhe do defeito ou dano.', 'warning'); return; }
        if (tipo === 'G' && $('#modalInstalado').val() === '') { mensagem('Informe se a peça foi instalada no veículo.', 'warning'); return; }
        if (tipo === 'G' && !$.trim($('#modalCondicaoEmbalagem').val())) { mensagem('Informe as condições da embalagem.', 'warning'); return; }
        selecionados.push({
            TipoCodigo: tipo, NotaFiscalId: ocorrenciaAtual.NotaFiscalId, NotaFiscalItemId: ocorrenciaAtual.NotaFiscalItemId,
            VolumeNr: ocorrenciaAtual.VolumeNr, QuantidadeReclamada: qtd,
            QuantidadeRecebida: tipo === 'B' ? n($('#modalRecebida').val()) : null,
            ItemRecebidoNr: tipo === 'C' ? $.trim($('#modalItemRecebido').val()) : null,
            InstaladoVeiculo: tipo === 'G' ? $('#modalInstalado').val() === 'true' : null,
            CondicaoEmbalagem: tipo === 'G' ? $.trim($('#modalCondicaoEmbalagem').val()) : null,
            Observacao: $.trim($('#modalObservacao').val()), DataLimite: contextoAtual.DataLimite,
            SaldoDisponivel: contextoAtual.SaldoLocal,
            origem: ocorrenciaAtual
        });
        renderItens();
        $('#modalAnomaliaItem').modal('hide');
    });

    function renderItens() {
        var html = '';
        selecionados.forEach(function (i, pos) {
            html += '<tr><td><span class="label label-primary">' + i.TipoCodigo + '</span></td><td>' + esc(i.origem.NotaFiscalNr) + '</td><td>' + esc(i.VolumeNr) + '</td><td><b>' + esc(i.origem.ItemNr) + '</b></td><td>' + esc(i.origem.Descricao) + '</td><td>' + fmtNumero(i.origem.QuantidadeNF) + '</td><td>' + fmtNumero(i.SaldoDisponivel) + '</td><td>' + fmtNumero(i.QuantidadeReclamada) + '</td><td>' + fmtData(i.DataLimite) + '</td><td>' + esc(i.Observacao) + '</td><td><button type="button" class="btn btn-xs btn-danger remover" data-pos="' + pos + '" title="Remover"><i class="fa fa-trash"></i></button></td></tr>';
        });
        $('#tbItensAnomalia tbody').html(html || '<tr><td colspan="11" class="text-center anomalia-empty">Nenhum item selecionado.</td></tr>');
    }
    $('#tbItensAnomalia').on('click', '.remover', function () { selecionados.splice($(this).data('pos'), 1); renderItens(); });

    $('#btnFinalizar').on('click', function () {
        if (!selecionados.length) { mensagem('Inclua pelo menos um item na anomalia.', 'warning'); return; }
        var botao = $(this).prop('disabled', true);
        var itens = selecionados.map(function (i) { return {
            TipoCodigo:i.TipoCodigo, NotaFiscalId:i.NotaFiscalId, NotaFiscalItemId:i.NotaFiscalItemId,
            VolumeNr:i.VolumeNr, QuantidadeReclamada:i.QuantidadeReclamada, QuantidadeRecebida:i.QuantidadeRecebida,
            ItemRecebidoNr:i.ItemRecebidoNr, Observacao:i.Observacao,
            InstaladoVeiculo:i.InstaladoVeiculo, CondicaoEmbalagem:i.CondicaoEmbalagem
        }; });
        $.post('@Url.Action("Finalizar")', {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            payload: JSON.stringify({ Observacao: $('#observacaoProcesso').val(), Itens: itens })
        }).done(function (r) {
            swal({ title: 'Cadastro de Anomalias', text: r.message, icon: 'success', button: { text: 'OK', className: 'swal-btn-success' } })
                .then(function () { window.location.href = '@Url.Action("Detalhe")/' + r.id; });
        }).fail(falha).always(function () { botao.prop('disabled', false); });
    });
}());
</script>
}
