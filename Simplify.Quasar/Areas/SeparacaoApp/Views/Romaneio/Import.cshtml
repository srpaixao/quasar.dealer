@using System.Linq
@model Simplify.Quasar.Areas.SeparacaoApp.ViewModels.RomaneioViewModel
@{
    ViewBag.Title = "Romaneios";
    ViewBag.Description = "Atualizações";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .layout-table th, .layout-table td {
        vertical-align: middle !important;
    }
</style>

<section class="content-header">
    <h1>@ViewBag.Title<small>@ViewBag.Description</small></h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li><a href="@Url.Action("Index", "Romaneio", new { area = "SeparacaoApp" })">Separação</a></li>
                <li><a href="@Url.Action("Conferencia", "Romaneio", new { area = "SeparacaoApp" })">Conferência</a></li>
                <li><a href="@Url.Action("Administracao", "Romaneio", new { area = "SeparacaoApp" })">Finalizado</a></li>
                <li><a href="@Url.Action("AnaliseNaoGerados", "Romaneio", new { area = "SeparacaoApp" })">Não Gerados</a></li>
                <li class="active"><a href="@Url.Action("Atualizacao", "Romaneio", new { area = "SeparacaoApp" })">Atualização</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active">
                    <div class="box-body">
                        @if (TempData["Flash.Message"] != null)
                        {
                            <div class="alert alert-@TempData["Flash.Type"]" style="margin-top:12px;">
                                @TempData["Flash.Message"]
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-9">
                                @using (Html.BeginForm("UploadPlanilha", "Romaneio", new { area = "SeparacaoApp" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="dataInicialUpload" name="dataInicial" value="@Model.DataInicial.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" id="dataFinalUpload" name="dataFinal" value="@Model.DataFinal.ToString("yyyy-MM-dd")" />
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <div class="form-group">
                                                <label>Planilha de Atualização</label>
                                                <input type="file" name="arquivo" class="form-control" accept=".xls,.xlsx,.csv,.txt" />
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div style="margin-top:25px;">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-upload"></i> Importar e Atualizar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-3">
                                @using (Html.BeginForm("GerarRomaneios", "Romaneio", new { area = "SeparacaoApp" }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <div style="margin-top:25px;">
                                        <button type="submit" class="btn btn-default">
                                            <i class="fa fa-plus-circle"></i> Gerar Romaneios
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                @if (Model.ImportSummary != null)
                                {
                                    <h4>Resumo da Importação</h4>
                                    <div class="well">
                                        <div><strong>Processados:</strong> @Model.ImportSummary.Processados</div>
                                        <div><strong>Atualizados:</strong> @Model.ImportSummary.Atualizados</div>
                                        <div><strong>Criados:</strong> @Model.ImportSummary.Criados</div>
                                        <div><strong>Status 1 -&gt; 2:</strong> @Model.ImportSummary.StatusAlterados</div>
                                        <div><strong>Erros:</strong> @Model.ImportSummary.Erros</div>
                                    </div>

                                    if (Model.ImportSummary.Mensagens.Any())
                                    {
                                        <div class="alert alert-warning">
                                            <strong>Observações</strong>
                                            <ul style="margin-top:8px;">
                                                @foreach (var mensagem in Model.ImportSummary.Mensagens.Take(10))
                                                {
                                                    <li>@mensagem</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
