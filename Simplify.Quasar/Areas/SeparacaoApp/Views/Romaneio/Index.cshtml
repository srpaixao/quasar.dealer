@model Simplify.Quasar.Areas.SeparacaoApp.ViewModels.RomaneioViewModel
@{
    ViewBag.Title = "Romaneios";
    ViewBag.Description = "Separação";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .summary-card {
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 12px 14px;
        margin-bottom: 12px;
        background: #fff;
        min-height: 86px;
    }

    .summary-card .summary-value {
        display: block;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.1;
    }

    .summary-card .summary-label {
        color: #6b7280;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .summary-card.is-white {
        background: #ffffff;
        border-color: #d2d6de;
    }

    .summary-card.is-red {
        background: #fbeaea;
        border-color: #dd4b39;
    }

    .summary-card.is-yellow {
        background: #fcf8e3;
        border-color: #f39c12;
    }

    .summary-card.is-green {
        background: #e8f6ec;
        border-color: #00a65a;
    }
</style>

<section class="content-header">
    <h1>@ViewBag.Title<small>@ViewBag.Description</small></h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active"><a href="@Url.Action("Index", "Romaneio", new { area = "SeparacaoApp" })">Separação</a></li>
                <li><a href="@Url.Action("Conferencia", "Romaneio", new { area = "SeparacaoApp" })">Conferência</a></li>
                @if (Model.CanViewFullMenu)
                {
                    <li><a href="@Url.Action("Administracao", "Romaneio", new { area = "SeparacaoApp" })">Finalizado</a></li>
                    <li><a href="@Url.Action("AnaliseNaoGerados", "Romaneio", new { area = "SeparacaoApp" })">Não Gerados</a></li>
                    <li><a href="@Url.Action("Atualizacao", "Romaneio", new { area = "SeparacaoApp" })">Atualização</a></li>
                }
            </ul>
            <div class="tab-content">
                <div class="tab-pane active">
                    <div class="box-body">
                        @if (TempData["Flash.Message"] != null)
                        {
                            <div class="alert alert-@TempData["Flash.Type"]" style="margin-top:12px;">
                                @TempData["Flash.Message"]
                            </div>
                        }

                        <div class="row" style="margin-top:12px;">
                            <div class="col-md-2 col-sm-4">
                                <div class="summary-card is-white">
                                    <span class="summary-label">Não Gerado</span>
                                    <span class="summary-value">@Model.TotalNaoGerado</span>
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <div class="summary-card is-red">
                                    <span class="summary-label">Pendente</span>
                                    <span class="summary-value">@Model.TotalAguardandoSeparacao</span>
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <div class="summary-card is-yellow">
                                    <span class="summary-label">Em Processo</span>
                                    <span class="summary-value">@Model.TotalEmSeparacao</span>
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <div class="summary-card is-green">
                                    <span class="summary-label">Finalizado</span>
                                    <span class="summary-value">@Model.TotalFinalizado</span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                @using (Html.BeginForm("IniciarSeparacao", "Romaneio", new { area = "SeparacaoApp" }, FormMethod.Post, new { @class = "row", id = "form-iniciar-separacao" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Picker</label>
                                            @Html.DropDownListFor(m => m.PickerId, Model.PickerDDL, "-- Selecione --", new { @class = "form-control", @id = "pickerId" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Romaneio Nr</label>
                                            @Html.TextBoxFor(m => m.RomaneioNr, new { @class = "form-control", @id = "romaneioNr", @placeholder = "Digite o Romaneio Nr e pressione Enter", @autocomplete = "off" })
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <hr />

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="tb-romaneios-separacao">
                                <thead>
                                    <tr>
                                        <th>Romaneio Nr</th>
                                        <th>Área</th>
                                        <th>Prioridade</th>
                                        <th>Vendedor</th>
                                        <th>Contato Nr</th>
                                        <th>Status</th>
                                        <th>Dt/Hr</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.GridItems)
                                    {
                                        <tr>
                                            <td>
                                                <a href="#" class="select-romaneio" data-romaneio-nr="@item.RomaneioNr">@item.RomaneioNr</a>
                                            </td>
                                            <td>@item.Area</td>
                                            <td>@(item.Prioridade.HasValue ? item.Prioridade.Value.ToString() : "-")</td>
                                            <td>@item.UsuarioApollo</td>
                                            <td>@(item.ContatoNr.HasValue ? item.ContatoNr.Value.ToString() : "-")</td>
                                            <td>@item.Status</td>
                                            <td>@(item.DataRomaneio.HasValue ? item.DataRomaneio.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>
    <script>
        $(function () {
            var pickerStorageKey = 'separacaoapp-picker-id';

            function tryStartSeparacao() {
                if ($.trim($('#romaneioNr').val()).length > 0 && $('#pickerId').val()) {
                    $('#form-iniciar-separacao').submit();
                }
            }

            function restorePicker() {
                var lastPickerId = window.localStorage.getItem(pickerStorageKey);
                if (!lastPickerId) {
                    return;
                }

                if ($('#pickerId option[value="' + lastPickerId + '"]').length > 0) {
                    $('#pickerId').val(lastPickerId);
                }
            }

            $('#tb-romaneios-separacao').DataTable({
                paging: true,
                info: true,
                lengthChange: true,
                pageLength: 50,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Todos']],
                ordering: true,
                order: [[2, 'asc'], [0, 'asc']],
                language: {
                    search: "Pesquisar:",
                    lengthMenu: "Exibir _MENU_ itens",
                    zeroRecords: "Nenhum romaneio encontrado",
                    info: "Exibindo _START_ a _END_ de _TOTAL_ registros",
                    infoEmpty: "Exibindo 0 a 0 de 0 registros",
                    paginate: {
                        first: "Primeira",
                        last: "Última",
                        next: "Próxima",
                        previous: "Anterior"
                    }
                }
            });

            restorePicker();

            $('#romaneioNr').on('keydown', function (event) {
                if (event.key !== 'Enter') {
                    return;
                }

                event.preventDefault();

                if ($('#pickerId').val()) {
                    tryStartSeparacao();
                    return;
                }

                $('#pickerId').focus();
            });

            $('#tb-romaneios-separacao').on('click', '.select-romaneio', function (event) {
                event.preventDefault();

                var romaneioNr = $(this).data('romaneio-nr');
                if (!romaneioNr) {
                    return;
                }

                $('#romaneioNr').val(String(romaneioNr));

                if ($('#pickerId').val()) {
                    tryStartSeparacao();
                    return;
                }

                $('#pickerId').focus();
            });

            $('#pickerId').on('change', function () {
                window.localStorage.setItem(pickerStorageKey, $(this).val() || '');

                if ($(this).val()) {
                    $('#romaneioNr').focus();
                }

                if ($.trim($('#romaneioNr').val()).length > 0) {
                    tryStartSeparacao();
                }
            });
        });
    </script>
}
