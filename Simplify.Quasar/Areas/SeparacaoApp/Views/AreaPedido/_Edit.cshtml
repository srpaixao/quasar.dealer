@model Simplify.Quasar.Areas.SeparacaoApp.ViewModels.AreaPedidoViewModel
@{
    Layout = null;
    string selectedArea = (Model.Area ?? string.Empty).Trim();
    var options = (Model.AreaRomaneioDDL ?? System.Linq.Enumerable.Empty<SelectListItem>()).ToList();
    var selectedOption = options.FirstOrDefault(o => o.Selected);
    if (selectedOption == null && !string.IsNullOrWhiteSpace(selectedArea))
    {
        selectedOption = options.FirstOrDefault(o =>
            !string.IsNullOrWhiteSpace(o.Text) &&
            o.Text.StartsWith(selectedArea, System.StringComparison.OrdinalIgnoreCase));
    }
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="modal-header bg-blue-gradient">
        <span><i class="fa fa-pencil fa-fw"></i>&nbsp;&nbsp;Modificar &Aacute;rea Pedido</span>
    </div>

    <div class="modal-body">
        @Html.ValidationSummary(false, string.Empty, new { @class = "text-red" })

        <div class="row">
            <div class="col-xs-12">
                <div class="form-group">
                    <label class="form-label">Vendedor</label>
                    @Html.TextBoxFor(m => m.UsuarioApollo, new { @class = "form-control", @autocomplete = "off", @maxlength = "100" })
                    @Html.ValidationMessageFor(m => m.UsuarioApollo, null, new { @class = "text-red text-nowrap" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <div class="form-group">
                    <label class="form-label">&Aacute;rea Romaneio</label>
                    <select class="form-control" id="AreaId" name="AreaId">
                        @if (selectedOption == null)
                        {
                            <option value="" selected>-- Selecione --</option>
                        }
                        else
                        {
                            <option value="@selectedOption.Value" selected>@selectedOption.Text</option>
                        }

                        @foreach (var option in options)
                        {
                            if (selectedOption != null && string.Equals(option.Value, selectedOption.Value, System.StringComparison.Ordinal))
                            {
                                continue;
                            }

                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.AreaId, null, new { @class = "text-red text-nowrap" })
                </div>
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <div class="pull-right">
            <button type="submit" class="btn btn-success"><i class="fa fa-check fa-fw"></i> Salvar</button>
            <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa fa-times fa-fw"></i> Fechar</button>
        </div>
    </div>
}

<script>
    $('.input-validation-error').parents('.form-group').addClass('has-error');

    $('.form-control').on('change', function () {
        $(this).parent().removeClass('has-error');
        $(this).next().html('');
    });
</script>
