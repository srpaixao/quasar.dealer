@model Simplify.Quasar.Areas.RecebimentoApp.ViewModels.FornecedorViewModel

@{
    ViewBag.Title = "Edit";
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="modal-header bg-blue-gradient">
            <span><i class="fa-regular fa-edit fa-fw"></i>&nbsp;&nbsp;Alterar cadastro de Fornecedor</span>
        </div>

        @Html.HiddenFor(m=> m.Id)

        <div class="modal-body">
            <div class="row">
                <div class="col-xs-12 col-lg-4">
                    <div class="form-group">
                        <label class="form-label">CNPJ</label>
                        @Html.TextBoxFor(m => m.CNPJ, new { @class = "form-control text-center", @autocomplete = "off" })
                        @Html.ValidationMessageFor(x => x.CNPJ, null, new { @class = "text-red text-nowrap" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="form-label">Razão Social</label>
                        @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", @autocomplete = "off", @maxlength = "100" })
                        @Html.ValidationMessageFor(x => x.Nome, null, new { @class = "text-red text-nowrap" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-6 col-lg-3">
                    <div class="form-group">
                        <label>CEP</label>
                        @Html.TextBoxFor(m => m.Endereco_CEP, new { @class = "form-control text-center", @maxlength = "8", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-7">
                    <div class="form-group">
                        <label>Logradouro</label>
                        @Html.TextBoxFor(m => m.Endereco_Logradouro, new { @class = "form-control", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-6 col-lg-2">
                    <div class="form-group">
                        <label>Número</label>
                        @Html.TextBoxFor(m => m.Endereco_Numero, new { @class = "form-control text-center", @autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div id="msg-cep" style="display:none;">
                <i class="fa fa-fw fa-exclamation-triangle text-orange"></i> CEP não localizado
            </div>

            <div class="row">
                <div class="col-xs-6 col-lg-6">
                    <div class="form-group">
                        <label>Complemento</label>
                        @Html.TextBoxFor(m => m.Endereco_Complemento, new { @class = "form-control", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label>Bairro</label>
                        @Html.TextBoxFor(m => m.Endereco_Bairro, new { @class = "form-control", @autocomplete = "off" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-8">
                    <div class="form-group">
                        <label>Cidade</label>
                        @Html.TextBoxFor(m => m.Endereco_Cidade, new { @class = "form-control", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-4">
                    <div class="form-group">
                        <label>Estado</label>
                        @Html.DropDownListFor(m => m.EstadoUF, Model.EstadoDDL, "", new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="form-label">Observações</label>
                        @Html.TextAreaFor(m => m.Observacoes, new { @class = "form-control", @autocomplete = "off", @rows = "3", @maxlength = "500" })
                        @Html.ValidationMessageFor(x => x.Observacoes, null, new { @class = "text-red text-nowrap" })
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <div class="pull-right">
                <button type="submit" id="btnSave" class="btn btn-success"><i class="fa-solid fa-check fa-fw"></i> Salvar</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa-solid fa-xmark fa-fw"></i> Fechar</button>
            </div>
        </div>

    }
}
else
{
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
}

<script>
    $('.input-validation-error').parents('.form-group').addClass('has-error');

    $('.form-control').on('change', function () {
        $(this).parent().removeClass('has-error');
        $(this).next().html('');
    });

    // inputmask está definido no bundles
    $('#CNPJ').inputmask({
        mask: ['99.999.999/9999-99'],
        keepStatic: true
    });

    $('input[type="checkbox"], input[type="radio"]').iCheck({
        checkboxClass: "icheckbox_minimal-blue",
        radioClass: "iradio_minimal-blue"
    });

    // Acessar API CEP - Coleta
    $("#Endereco_CEP").blur(function () {
        if ($(this).val()) {
            $('#msg-cep').hide();

            $("#Endereco_Logradouro").val('');
            $("#Endereco_Numero").val('');
            $("#Endereco_Complemento").val('');
            $("#Endereco_Bairro").val('');
            $("#Endereco_Cidade").val('');
            $('#EstadoUF').val('');

            var cep = $(this).val();
            cep = cep.replace('.', '').replace('-', '');
            if (cep.length == 8) {
                $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                    if (!("erro" in dados)) {
                        $("#Endereco_Logradouro").val(dados.logradouro);
                        $("#Endereco_Numero").val('');
                        $("#Endereco_Complemento").val('');
                        $("#Endereco_Bairro").val(dados.bairro);
                        $("#Endereco_Cidade").val(dados.localidade);
                        $('#EstadoUF').val(dados.uf);
                        $('#Endereco_Numero').focus();
                    } else {
                        $('#msg-cep').show();
                        $('#Endereco_Logradouro').focus();
                    }
                });
            }
        }
    });
</script>

