@model IEnumerable<Simplify.Quasar.Areas.RecebimentoApp.ViewModels.RetornoInternoViewModel>

@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Retornos Internos";

    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>

    th, td {
        text-align: center !important;
        vertical-align: middle !important;
    }

</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">

        <div class="box-body">
            <div class="row">
                <div class="col-xs-12">
                    <a href="@Url.Action("Create","RetornoInterno", new { area = "RecebimentoApp" })" class="btn btn-success"><i class="fa-regular fa-file-lines"></i> Cadastrar Documento</a>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-condensed table-bordered table-hover table-small" id="tbRetorno">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th>Tipo</th>
                                    <th>Origem</th>
                                    <th>Destino</th>
                                    <th>Responsável</th>
                                    <th>Itens</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Edit","RetornoInterno", new { area = "RecebimentoApp", id=item.Id })">@item.NrDocumento</a>
                                        </td>
                                        <td>@item.TipoDocumentoRetornoNome</td>
                                        <td>@item.LocalOrigemNome</td>
                                        <td>@item.LocalDestinoNome</td>
                                        <td>@item.Responsavel</td>
                                        <td>@item.QtdItens</td>
                                        <td>@item.StatusDocumentoRetornoNome</td>
                                        <td>
                                            <a href="#" class="delete @(item.AllowDelete && item.FinalizadoEm == null ? string.Empty : "hide")" title="Excluir" data-id="@item.Id"><i class="fa-regular fa-trash-can fa-lg fa-fw text-red"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>
    <script src="~/Scripts/DataTables/plugins/sorting/datetime-moment.js"></script>

    <script>

        $(document).ready(function () {

            $.ajaxSetup({ cache: false });
            $.fn.dataTable.moment('DD/MM/YYYY HH:mm:ss');

            var tbRetorno = $('#tbRetorno').DataTable({
                processing: false,
                deferRender: true,
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: -1 }
                ],
                drawCallback: function (settings) {
                    //console.log("Draw");
                },
                fnInitComplete: function () {
                    $("#loading").hide();
                    //console.log("fnInitComplete");
                },
                language: {
                    processing: "Carregando dados...",
                    lengthMenu: "Exibir _MENU_ itens por página",
                    search: "Procurar:",
                    zeroRecords: "Nenhum item localizado",
                    info: "Exibindo _START_ de _END_ de um total de _TOTAL_ itens",
                    infoEmpty: "Exibindo 0 de 0 itens",
                    infoFiltered: "",
                    thousands: ".",
                    decimal: ",",
                    paginate: {
                        first: "Primeira",
                        last: "Última",
                        next: "Próxima",
                        previous: "Anterior"
                    }
                }
            })

            $("#tbRetorno").on("click", "a.delete", function (e) {
                var docId = $(this).attr("data-id");
                var doc = $(this).closest('tr').find('td:eq(0)').text().trim();

                var div = document.createElement("div");
                div.innerHTML = "<span>Confirma a exclusão do documento <b>" + doc + "</b> ?</span>";
                swal({
                    title: "Cadastro de Retorno Interno",
                    content: div,
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: '@Url.Action("Delete", "RetornoInterno", new { area = "RecebimentoApp"})',
                            data: { id: docId },
                        success: function (data) {
                            location.reload();
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            console.log('erro');
                        }
                    })
                    }
                });
            });

            function bindForm(dialog) {
                $('form', dialog).submit(function () {
                    $.ajax({
                        url: this.action,
                        type: this.method,
                        data: $(this).serialize(),
                        success: function (result) {
                            if (result.success) {
                                $('#myModal').modal('hide');
                                //Refresh
                                location.reload();
                            } else {
                                $('#myModalContent').html(result);
                                bindForm();
                            }
                        },
                        error: function (data) {
                            console.log('erro', data);
                        }
                    });
                    return false;
                });
            }

        })
    </script>
}
