@model Simplify.Quasar.Areas.RecebimentoApp.ViewModels.RetornoInternoViewModel

@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Documento de Retorno Interno";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .datatable_filter {
        padding-bottom: 15px;
    }

    select.filter {
        margin-right: 15px;
        border: 1px solid #eee;
    }

    div.filter-option, a > span.text {
        font-size: 13px !important;
    }

    select.selected {
        border: 2px solid #00a65a;
    }

    th, td {
        text-align: center;
        vertical-align: middle !important;
    }

    #tbItensRetorno {
        table-layout: fixed;
    }

        #tbItensRetorno tr > td > input {
            height: 28px !important;
        }

    div.padding-r0 {
        padding-right: 0px;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.JsonItens)

                <div class="row">
                    <div class="col-xs-12 col-lg-2">
                        <div class="form-group">
                            <label class="form-label">Nr Documento</label>
                            @Html.TextBoxFor(m => m.NrDocumento, new { @class = "form-control", @autocomplete = "off", @disabled = "disabled" })

                        </div>
                    </div>
                    <div class="input-itemDoc">
                        <div class="col-xs-12 col-lg-2">
                            <div class="form-group">
                                <label class="form-label">Tipo</label>
                                @if (Model.FinalizadoEm == null)
                                {
                                    @Html.DropDownListFor(m => m.TipoDocumentoRetornoId, Model.TipoDocumentoRetornoDDL, new { @class = "form-control" })
                                }
                                else
                                {
                                    @Html.DropDownListFor(m => m.TipoDocumentoRetornoId, Model.TipoDocumentoRetornoDDL, new { @class = "form-control", @disabled = "disabled" })
                                }
                            </div>
                        </div>

                        <div class="col-xs-12 col-lg-2">
                            <div class="form-group">
                                <label class="form-label">Origem</label>
                                @if (Model.FinalizadoEm == null)
                                {
                                    @Html.DropDownListFor(m => m.LocalOrigemId, Model.LocalOrigemDDL, new { @class = "form-control" })
                                }
                                else
                                {
                                    @Html.DropDownListFor(m => m.LocalOrigemId, Model.LocalOrigemDDL, new { @class = "form-control", @disabled = "disabled" })
                                }
                            </div>
                        </div>
                        <div class="col-xs-12 col-lg-2">
                            <div class="form-group">
                                <label class="form-label">Destino</label>
                                @if (Model.FinalizadoEm == null)
                                {
                                    @Html.DropDownListFor(m => m.LocalDestinoId, Model.LocalDestinoDDL, new { @class = "form-control" })
                                }
                                else
                                {
                                    @Html.DropDownListFor(m => m.LocalDestinoId, Model.LocalDestinoDDL, new { @class = "form-control", @disabled = "disabled" })
                                }
                            </div>
                        </div>
                        <div class="col-xs-12 col-lg-4">
                            <div class="form-group">
                                <label class="form-label">Responsável</label>
                                @if (Model.FinalizadoEm == null)
                                {
                                    @Html.TextBoxFor(m => m.Responsavel, new { @class = "form-control", @autocomplete = "off" })
                                }
                                else
                                {
                                    @Html.TextBoxFor(m => m.Responsavel, new { @class = "form-control", @autocomplete = "off", @disabled = "disabled" })
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="input-itemDoc">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="form-group">
                                <label class="form-label">Observações</label>
                                @if (Model.FinalizadoEm == null)
                                {
                                    @Html.TextBoxFor(m => m.Observacoes, new { @class = "form-control", @autocomplete = "off" })
                                }
                                else
                                {
                                    @Html.TextBoxFor(m => m.Observacoes, new { @class = "form-control", @autocomplete = "off", @disabled = "disabled" })
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <a href="@Url.Action("Index","RetornoInterno", new { area = "RecebimentoApp"})" class="btn btn-primary"><i class="fa fa-arrow-left"></i> Retornar</a>
                        <button type="submit" class="btn btn-success @(Model.FinalizadoEm == null ? string.Empty : "hide")"><i class="fa fa-check"></i> Salvar</button>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:10px;">
                    <div class="col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-condensed table-bordered table-hover table-small" id="tbItensRetorno">
                                <thead>
                                    <tr>
                                        <th class="hide"></th>
                                        <th class="bg-blue-gradient" style="width:5%">Item</th>
                                        <th class="bg-blue-gradient" style="width:15%">Código do Material</th>
                                        <th class="bg-blue-gradient" style="width:60%">Descrição do material</th>
                                        <th class="hide" style="width:20%">Locação</th>
                                        <th class="bg-blue-gradient" style="width:10%">Quantidade</th>
                                        <th class="bg-blue-gradient" style="width:10%">Qtd Armazenada</th>
                                        @if (Model.FinalizadoEm == null)
                                        {
                                            <th class="bg-blue-gradient" style="width:5%"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model._itens)
                                    {
                                        <tr>
                                            <td class="hide">@item.Id</td>
                                            <td class="text-muted" style="font-size:14px"></td>
                                            <td>@item.ItemNr</td>
                                            <td class="text-left">@item.ItemNrDescricao</td>
                                            <td class="text-left hide"><span style="margin-left:12px"></span></td>
                                            <td>
                                                @if (Model.FinalizadoEm == null && item.QtdArmazenada == 0)
                                                {
                                                    <input type="text" class="form-control text-center integer" value="@item.Quantidade.Value.ToString("N0")" />
                                                }
                                                else
                                                {
                                                    <span>@item.Quantidade.Value.ToString("N0")</span>
                                                }
                                            </td>
                                            <td>@item.QtdArmazenada.Value.ToString("N0")</td>
                                            @if (Model.FinalizadoEm == null)
                                            {
                                                <td>
                                                    @if (item.QtdArmazenada == 0)
                                                    {
                                                        <a href="#" class="@(item.QtdArmazenada == 0 ? string.Empty : "hide")"><i class="fa fa-lg fa-fw fa-trash-o text-red"></i></a>
                                                    }
                                                </td>
                                            }

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            }
        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function Renumerar() {
            var rows = $("#tbItensRetorno tbody tr").length;
            var row = 1;
            $("#tbItensRetorno tbody tr").each(function () {
                $(this).find('td:eq(1)').text(row + '/' + rows);
                row++;
            })
        }

        $(document).ready(function () {

            Renumerar();

            // Remove qualquer caractere que não seja número
            $('.integer').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            $('#tbItensRetorno > tbody').on('click', 'a', function (e) {
                e.preventDefault();

                swal({
                    title: "Cadastro de Retorno Interno",
                    text: "Confirma a exclusão do item ?",
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        $(this).closest('tr').remove();
                        Renumerar();
                        if ($('#tbItensRetorno > tbody > tr').length < 1) {
                            $('#btnSalvar').hide();
                        }
                    }
                });
            })

            $('form').submit(function (e) {
                e.preventDefault();

                var itens = [];
                var erro = false;
                var primeiroErro = null;

                $('#tbItensRetorno tr').each(function (rowIndex, r) {
                    if (rowIndex !== 0) {
                        var cols = $(this).find('td');
                        var qtd = cols.find('input').length > 0 ? cols.find('input').val() : cols.find('span').text();

                        if (cols.find('input').length > 0 && (qtd === "" || qtd === "0")) {
                            erro = true;
                            if (primeiroErro === null) {
                                primeiroErro = cols.find('input');
                            }
                        }

                        var item = {
                            id: cols[0].innerText,
                            quantidade: qtd
                        };
                        itens.push(item);
                    }
                });

                if (erro) {
                    msg = 'Informe a quantidade do item!';
                    var div = document.createElement("div");
                    div.innerHTML = "<h4 class='swal-text-warning'>" + msg + "</h4>";

                    swal({
                        title: "Cadastro de Retorno Interno",
                        content: div,
                        buttons: {
                            confirm: {
                                className: "swal-btn-info"
                            }
                        }
                    }).then(function () {
                        if (primeiroErro !== null) {
                            primeiroErro.focus();
                        }
                    });

                    return false;
                } else {
                    $('#JsonItens').val(JSON.stringify(itens));
                    console.log(itens);
                    this.submit();
                }
            });

        });
    </script>
}
