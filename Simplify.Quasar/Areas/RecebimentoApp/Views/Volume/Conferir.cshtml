@model IEnumerable<Simplify.Quasar.Areas.RecebimentoApp.ViewModels.VolumeViewModel>

@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Conferir Volumes/Peças";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    /*body.modal-open .modal {
        display: flex !important;
        height: 100%;
    }

        body.modal-open .modal .modal-dialog {
            margin: auto;
        }*/

    th, td {
        text-align: center;
        vertical-align: middle;
    }

    .disabled-box {
        opacity: 0.6;
    }

        .disabled-box:hover {
            opacity: 1;
        }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="ItemNr" class="form-control" placeholder="Item Nr" style="font-size:40px; font-weight: bold; height:60px">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="Descricao" class="form-control" placeholder="Descrição" style="font-size:40px; font-weight: bold; height:60px">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="Locacao" class="form-control" placeholder="locação" style="font-size:40px; font-weight: bold; height:60px">
                    </div>
                </div>
            </div>

            <hr />
            <div class="row" hidden>
                <div class="col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-condensed table-bordered table-hover table-small" id="tbItemNr">                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

</section>

@section Scripts {

    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>

    <script>

        $(document).ready(function () {

            // Leitura do Item Nr
            $('#itemnr').on('keyup', function (event) {
                event.preventDefault();

                var input = $(this).val();
                if (event.keyCode === 13) {
                    $(this).val('');

                    //let isnum = /^\d+$/.test(input);
                    // if (!isnum || input.length != 8 || input.length != 10) {
                    //if (input.length != 8) {
                    //    return;
                    //}

                    //var areaid = $("#AreaDDL").val();

                    $.ajax({
                        type: 'POST',
                        dataType: 'json',
                        url: '@Url.Action("PesquisaItemNr", "Volume")',
                        data: { itemnr: input, }
                    }).done(function (response) {
                        $('#itemnr').focus();
                        if (response.erro == false) {
                            LoadDataTable(1);
                            //$('#count-total').text(response.total);
                            //$('#count-pendente').text(response.pendentes);
                            //$('#count-conferido').text(response.conferidos);
                            //$('#count-incorreto').text(response.incorretos);
                            //$('#divVolume').removeClass('hide');
                            if (response.finalizado) {
                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-success'>" + response.msg + "</h4>";
                                swal({
                                    title: "Armazenagem de Peças",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            visible: false
                                        },
                                        cancel: {
                                            text: "Fechar",
                                            className: "swal-btn-danger",
                                            closeModal: true,
                                            visible: true
                                        }
                                    }
                                })
                            }
                        } else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro na leitura do Item Nr!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Armazenagem de Peças",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        }
                    }).fail(function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.statusText
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro na leitura do Item Nr!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                        swal({
                            title: "Armazenagem de Peças",
                            content: div,
                            buttons: {
                                confirm: {
                                    visible: false
                                },
                                cancel: {
                                    text: "Fechar",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        })
                    })

                }

            })

        });
    </script>

}
