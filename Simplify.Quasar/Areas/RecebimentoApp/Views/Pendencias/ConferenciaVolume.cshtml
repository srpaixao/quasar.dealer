@model Simplify.Quasar.Areas.RecebimentoApp.ViewModels.ConferenciaVolumeViewModel
@using System.Linq
@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = Html.Raw("Confer&ecirc;ncia de Volumes");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var itens = Model.Itens ?? Enumerable.Empty<Simplify.Quasar.Areas.RecebimentoApp.ViewModels.ItensByVolumeViewModel>();
}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .conferencia-volume .search-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }

    .conferencia-volume .search-field {
        min-width: 280px;
        max-width: 420px;
        flex: 1 1 320px;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content conferencia-volume">
    @Html.AntiForgeryToken()
    <div class="box box-default">
        <div class="box-header with-border">
            <h3 class="box-title">Pesquisar Volume</h3>
        </div>
        <div class="box-body">
            @using (Html.BeginForm("ConferenciaVolume", "Pendencias", new { area = "RecebimentoApp" }, FormMethod.Get))
            {
                <div class="search-row">
                    <div class="form-group search-field">
                        <label>Volume Nr</label>
                        @Html.TextBoxFor(m => m.VolumeNr, new { @class = "form-control", @autocomplete = "off", @autofocus = "autofocus", @placeholder = "Digite o volume nr" })
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-search"></i> Pesquisar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.ConsultaRealizada)
    {
        if (!itens.Any())
        {
            <div class="alert alert-warning">@(string.IsNullOrWhiteSpace(Model.Mensagem) ? Html.Raw("Volume n&atilde;o localizado.") : Html.Raw(HttpUtility.HtmlEncode(Model.Mensagem)))</div>
        }
        else
        {
            <div class="box box-default" id="resultadoConferenciaVolume">
                <div class="box-body">
                    @Html.Partial("_ItensByVolumeGrid", itens)
                </div>
            </div>
        }
    }
</section>

@section Scripts {
    <script>
        window.onItensByVolumeStatusUpdated = function () {
        };
    </script>
    @Html.Partial("_ItensByVolumeGridScript")
}
