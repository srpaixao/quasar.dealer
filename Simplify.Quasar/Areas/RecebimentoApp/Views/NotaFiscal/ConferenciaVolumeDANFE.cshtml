@model IEnumerable<Simplify.Quasar.Areas.RecebimentoApp.ViewModels.VolumeViewModel>

@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Descarregamento GM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    th, td {
        text-align: center;
        vertical-align: middle;
    }

    .disabled-box {
        opacity: 0.6;
    }

    .disabled-box:hover {
        opacity: 1;
    }

    .conference-refresh-status {
        margin-top: 24px;
        padding: 10px 14px;
        border-radius: 10px;
        background: rgba(39, 139, 179, 0.10);
        color: var(--text-700);
        font-size: 13px;
        text-align: right;
    }

    .conference-refresh-status .fa {
        margin-right: 5px;
        color: var(--brand-500);
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">
            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label>Área de Recebimento</label>
                        @Html.DropDownList("AreaDDL", ViewBag.AreaDDL as SelectList, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div id="conference-refresh-status" class="conference-refresh-status" aria-live="polite">
                        <i class="fa fa-refresh"></i>
                        <span id="conference-last-refresh">Aguardando primeira atualização</span>
                        <span class="hidden-xs"> &middot; </span>
                        <span id="conference-next-refresh" class="hidden-xs">Próxima em 01:00</span>
                    </div>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-lg-3 col-xs-6">
                    <div class="small-box bg-purple">
                        <div class="inner">
                            <h3 id="count-total">0</h3>
                            <p class="info-box-text">Total</p>
                        </div>
                        <div class="icon">
                            <i class="fa fa-cubes"></i>
                        </div>
                        <a href="#" class="small-box-footer filter-datatable" data-status="0">Detalhes <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-xs-6">
                    <div class="small-box bg-orange disabled-box">
                        <div class="inner">
                            <h3 id="count-pendente">0</h3>
                            <p class="info-box-text">Pendentes</p>                            
                        </div>
                        <div class="icon">
                            <i class="fa fa-exclamation-triangle"></i>
                        </div>
                        <a href="#" class="small-box-footer filter-datatable" data-status="1">Detalhes <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-xs-6">
                    <div class="small-box bg-green disabled-box">
                        <div class="inner">
                            <h3 id="count-conferido">0</h3>
                            <p class="info-box-text">Confirmado</p>
                        </div>
                        <div class="icon">
                            <i class="fa fa-circle-check"></i>
                        </div>
                        <a href="#" class="small-box-footer filter-datatable" data-status="2">Detalhes <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-xs-6">
                    <div class="small-box bg-red disabled-box">
                        <div class="inner">
                            <h3 id="count-incorreto">0</h3>
                            <p class="info-box-text">Incorretos</p>
                        </div>
                        <div class="icon">
                            <i class="fa fa-rectangle-xmark"></i>
                        </div>
                        <a href="#" class="small-box-footer filter-datatable" data-status="3">Detalhes <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="danfe" class="form-control" placeholder="DANFE" maxlength="44" style="font-size:14px; font-weight: bold; width: 100%;">
                    </div>
                </div>
                <div class="col-xs-12 col-lg-1">
                    <a href="#" class="btn btn-success" id="btnReiniciar"><i class="fa fa-undo"></i> Reiniciar</a>
                </div>
            </div>

            <hr />
            <div class="row">
                <div class="col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-condensed table-bordered table-hover table-small" id="tbVolume">                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

</section>

@Html.Partial("_ConferenciaVolumeItens")

@section Scripts {

    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>

    <script>
        var currentStatusFilter = 0;
        var dtVolume = null;
        var conferenceRefreshTimer = null;
        var conferenceCountdownTimer = null;
        var conferenceNextRefreshAt = null;
        var conferencePendingCount = null;

        function FormatConferenceTime(date) {
            return String(date.getHours()).padStart(2, '0') + ':' +
                String(date.getMinutes()).padStart(2, '0') + ':' +
                String(date.getSeconds()).padStart(2, '0');
        }

        function UpdateConferenceCountdown() {
            if (conferencePendingCount === 0) {
                $('#conference-next-refresh').text('Atualização pausada: sem volumes pendentes');
                return;
            }

            if (!conferenceNextRefreshAt) {
                return;
            }

            var seconds = Math.max(0, Math.ceil((conferenceNextRefreshAt - Date.now()) / 1000));
            var minutes = Math.floor(seconds / 60);
            var remainingSeconds = seconds % 60;
            $('#conference-next-refresh').text(
                'Próxima em ' + String(minutes).padStart(2, '0') + ':' + String(remainingSeconds).padStart(2, '0')
            );
        }

        function RegisterConferenceRefreshSuccess(pendingCount) {
            conferencePendingCount = parseInt(pendingCount, 10) || 0;
            $('#conference-refresh-status').removeClass('text-danger');
            $('#conference-last-refresh').text('Última atualização: ' + FormatConferenceTime(new Date()));

            if (conferencePendingCount > 0) {
                conferenceNextRefreshAt = Date.now() + 60000;
            } else {
                conferenceNextRefreshAt = null;
            }

            UpdateConferenceCountdown();
        }

        function RegisterConferenceRefreshError() {
            $('#conference-refresh-status').addClass('text-danger');
            $('#conference-last-refresh').text('Falha na atualização automática');
        }

        function ApplyCardFilterState(status) {
            $('div.small-box').addClass('disabled-box');
            $('.filter-datatable[data-status="' + status + '"]').closest('div.small-box').removeClass('disabled-box');
        }

        function LoadDataTable(status) {
            //console.log("LoadDataTable",status)
            currentStatusFilter = status;

            var area = $('#AreaDDL').val();

            if ($.fn.DataTable.isDataTable('#tbVolume')) {
                $('#tbVolume').DataTable().destroy();
            }

            $('#tbVolume tbody').empty();
            dtVolume = $('#tbVolume').DataTable({
                deferRender: true,
                serverSide: true,
                autoWidth: true,
                processing: true,
                pageLength: 25,
                ajax: {
                    url: '@Url.Action("GetDataVolumeDANFE", "NotaFiscal", new { area = "RecebimentoApp" })',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: function (d) {
                        d.statusId = status;
                        d.areaId = area;
                        return JSON.stringify(d);
                    },
                    dataSrc: function (json) {
                        $('#count-total').text(json.totalCount || 0);
                        $('#count-pendente').text(json.pendenteCount || 0);
                        $('#count-conferido').text(json.conferidoCount || 0);
                        $('#count-incorreto').text(json.incorretoCount || 0);
                        RegisterConferenceRefreshSuccess(json.pendenteCount);
                        return json.data;
                    },
                    error: function () {
                        RegisterConferenceRefreshError();
                    }
                },
                columns: [
                    ///*{ data: 'StatusId', title: 'StatusId' },*/
                    //{ data: 'Area', title: 'Área' },
                    { data: 'VolumeNr', title: 'Volume' },
                    { data: 'NotaFiscalNr', title: 'Notas Fiscais' },
                    {
                        data: 'QtdeItens', title: 'Itens', render: function (data, type, row, meta) {
                            if (data == 0) {
                                return '';
                            }
                            else {
                                return data
                            };
                        }
                    },
                    { data: 'StatusNome', title: 'Status' },
                    {
                        data: 'CriadoEmTexto', title: 'Criado em'
                    }
                ],
                columnDefs: [{
                    targets: [3],
                    render: function (data, type, row) {
                        if (data == 'Pendente') {
                            return '<i class="fa fa-lg fa-fw fa-exclamation-triangle text-orange text-bold"></i><span class="text-orange text-bold"> ' + data + '</span>';
                        }
                        if (data == 'Conferido') {
                            return '<i class="fa fa-lg fa-fw fa-check text-green text-bold"></i><span class="text-green text-bold"> ' + data + '</span>';
                        }
                        if (data == 'Incorreto') {
                            return '<i class="fa fa-lg fa-fw fa-times text-red text-bold"></i><span class="text-red text-bold"> ' + data + '</span>';
                        }
                        return data;
                    }
                }],
                drawCallback: function () {
                    // console.log("drawCallback");
                },
                fnInitComplete: function () {
                    // console.log(""fnInitComplete")
                },
                language: {
                    processing: "Carregando dados...",
                    lengthMenu: "Exibir _MENU_ volumes por página",
                    search: "Procurar:",
                    zeroRecords: "Nenhum volume localizado",
                    info: "Exibindo _START_ de _END_ de um total de _TOTAL_ volumes",
                    infoEmpty: "Exibindo 0 de 0 volumes",
                    infoFiltered: "",
                    thousands: ".",
                    decimal: ",",
                    paginate: {
                        first: "Primeira",
                        last: "Última",
                        next: "Próxima",
                        previous: "Anterior"
                    }
                }
            });

            dtVolume.columns.adjust().draw(false);

        }

        function RefreshConferenceData() {
            if (!(conferencePendingCount > 0)) {
                if (conferencePendingCount === 0) {
                    UpdateConferenceCountdown();
                }
                return;
            }

            conferenceNextRefreshAt = Date.now() + 60000;
            UpdateConferenceCountdown();

            if (document.hidden || !$('#AreaDDL').val()) {
                return;
            }

            if ($.fn.DataTable.isDataTable('#tbVolume')) {
                $('#tbVolume').DataTable().ajax.reload(null, false);
            }
        }

        $(document).ready(function () {
            $('#AreaDDL').change(() => {
                LoadDataTable(currentStatusFilter);
            }).change();

            $('a.filter-datatable').click(function (e) {
                e.preventDefault();
                var status = parseInt($(this).data('status'), 10) || 0;
                ApplyCardFilterState(status);
                LoadDataTable(status);
            });

            // Leitura da DANFE
            $('#danfe').on('keyup', function (event) {
                event.preventDefault();
                var area = $('#AreaDDL').val();

                var input = $(this).val();
                if (event.keyCode === 13) {
                    $(this).val('');

                    let isnum = /^\d+$/.test(input);
                    if (!isnum || input.length != 44) {
                        alert("DANFE em formato incorreto!");
                        return;
                    }

                    $.ajax({
                        type: 'POST',
                        dataType: 'json',
                        url: '@Url.Action("AddVolume", "NotaFiscal")',
                        data: { danfe: input, areaid: area }
                    }).done(function (response) {
                        //console.log(response)
                        $('#danfe').focus();
                        if (response.erro == false) {
                            LoadDataTable(currentStatusFilter);
                            $('#teste').text(response.msg);
                            //console.log("count pendente", $('#count-pendente').text())
                            //console.log("count total", $('#count-total').text())
                            
                        } else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Não foi possível adicionar o volume!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Conferência de Volumes",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            }).then(() => {
                                 $('#danfe').focus();
                            })
                        }
                    }).fail(function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.error;
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-error'>Não foi possível adicionar o volume!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                        swal({
                            title: "Conferência de Volumes",
                            content: div,
                            buttons: {
                                confirm: {
                                    visible: false
                                },
                                cancel: {
                                    text: "Fechar",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        })
                    })
                }

            })

            // Leitura do volume
            $('#volume').on('keyup', function (event) {
                event.preventDefault();

                var input = $(this).val();
                if (event.keyCode === 13) {
                    $(this).val('');

                    let isnum = /^\d+$/.test(input);
                    // if (!isnum || input.length != 8 || input.length != 10) {
                    //if (input.length != 8) {
                    //    return;
                    //}

                    var areaid = $("#AreaDDL").val();

                    $.ajax({
                        type: 'POST',
                        dataType: 'json',
                        url: '@Url.Action("UpdateVolume", "NotaFiscal")',
                        //url: '@Url.Action("UpdateVolumeNotaFiscalItem", "NotaFiscalItem")',
                        data: { volume: input }
                    }).done(function (response) {
                        $('#volume').focus();
                        if (response.erro == false) {
                            LoadDataTable(currentStatusFilter);
                            //console.log("Passou")
                        } else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro na leitura do volume!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Conferência de Volumes",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        }
                    }).fail(function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.statusText
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro na leitura do volume!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                        swal({
                            title: "Conferência de Volumes",
                            content: div,
                            buttons: {
                                confirm: {
                                    visible: false
                                },
                                cancel: {
                                    text: "Fechar",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        })
                    })

                }

            })

            $('#btnReiniciar').click(function () {

                var div = document.createElement("div");
                div.innerHTML = "Confirma a operação ?<br><br><p><i class='fa fa-lg fa-exclamation-triangle text-orange'></i> ATENÇÃO: Todos os dados serão apagados!</p>";

                swal({
                    title: "Reiniciar conferência de volumes",
                    content: div,
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {

                        var area = $('#AreaDDL').val();

                        $.ajax({
                            type: 'POST',
                            dataType: 'json',
                            data: { areaId: area },
                            url: '@Url.Action("ReiniciarVolume", "NotaFiscal")',
                        }).done(function (response) {
                            if (response.erro == false) {
                                //console.lo("Passou2")
                                LoadDataTable(currentStatusFilter);
                              } else {
                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao reiniciar a operação!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                                swal({
                                    title: "Conferência de Volumes",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            visible: false
                                        },
                                        cancel: {
                                            text: "Fechar",
                                            className: "swal-btn-danger",
                                            closeModal: true,
                                            visible: true
                                        }
                                    }
                                })
                            }
                        }).fail(function (xhr, status, error) {
                            var errorMessage = xhr.status + ': ' + xhr.statusText
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Não foi possível reiniciar a operação!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                            swal({
                                title: "Conferência de Volumes",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        })
                    }
                });
            })

            conferenceNextRefreshAt = Date.now() + 60000;
            UpdateConferenceCountdown();
            conferenceRefreshTimer = window.setInterval(RefreshConferenceData, 60000);
            conferenceCountdownTimer = window.setInterval(UpdateConferenceCountdown, 1000);
            $(window).on('beforeunload', function () {
                window.clearInterval(conferenceRefreshTimer);
                window.clearInterval(conferenceCountdownTimer);
            });
        });
    </script>

    @Html.Partial("_ConferenciaVolumeItensScript")

}
