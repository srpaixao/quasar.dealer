@model Simplify.Quasar.Areas.RecebimentoApp.ViewModels.DevolucaoRecebimentoViewModel
@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Detalhamento da Devolu\u00E7\u00E3o";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var itens = Model.Itens ?? new List<Simplify.Quasar.Areas.RecebimentoApp.ViewModels.DevolucaoRecebimentoItemViewModel>();
}

<style>
    .devolucao-recebimento-box {
        border-top: 3px solid #1f5a7d;
    }

    .devolucao-recebimento-label {
        display: block;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .devolucao-recebimento-value {
        min-height: 34px;
        padding: 7px 10px;
        border: 1px solid #d2d6de;
        background: #f9fafc;
    }

    .devolucao-recebimento-table th,
    .devolucao-recebimento-table td {
        vertical-align: middle !important;
    }

    .devolucao-recebimento-table th.text-center,
    .devolucao-recebimento-table td.text-center {
        text-align: center !important;
    }

    .devolucao-recebimento-table th.text-right,
    .devolucao-recebimento-table td.text-right {
        text-align: right !important;
    }

    .devolucao-recebimento-actions {
        margin-top: 12px;
    }
    
    .devolucao-recebimento-status {
        max-width: 240px;
    }

    .devolucao-recebimento-required {
        border-color: #dd4b39 !important;
        background-color: #fff6f6;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default devolucao-recebimento-box">
        <div class="box-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            @using (Html.BeginForm("DevolucaoDetalhe", "NotaFiscal", new { area = "RecebimentoApp" }, FormMethod.Post, new { id = "devolucao-recebimento-form", data_status_ocorrencia = Model.StatusOcorrenciaId, data_status_finalizado = Model.StatusFinalizadoId }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.NotaFiscalId)
                @Html.HiddenFor(m => m.StatusOcorrenciaId)
                @Html.HiddenFor(m => m.StatusFinalizadoId)

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="devolucao-recebimento-label">Controle Nr</label>
                            <div class="devolucao-recebimento-value">@Model.ControleNr</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="devolucao-recebimento-label">Nota Fiscal</label>
                            <div class="devolucao-recebimento-value">@Model.NotaFiscalNr</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="devolucao-recebimento-label">Status</label>
                            @Html.DropDownListFor(m => m.StatusId, Model.StatusDDL, new { @class = "form-control devolucao-recebimento-status", id = "StatusId" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="devolucao-recebimento-label">&Uacute;ltima Atualiza&ccedil;&atilde;o</label>
                            <div class="devolucao-recebimento-value">@(Model.UltimaAtualizacao.HasValue ? Model.UltimaAtualizacao.Value.ToString("dd/MM/yyyy HH:mm:ss") : string.Empty)</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="devolucao-recebimento-label">Nome</label>
                            <div class="devolucao-recebimento-value">@Model.Emissor</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-condensed table-bordered table-hover devolucao-recebimento-table">
                                <thead>
                                    <tr>
                                        <th>Item Nr</th>
                                        <th>Descri&ccedil;&atilde;o</th>
                                        <th class="text-center">Quantidade</th>
                                        <th class="text-center">Qtde com Problema</th>
                                        <th>Ocorr&ecirc;ncia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (itens.Count > 0)
                                    {
                                        for (int i = 0; i < itens.Count; i++)
                                        {
                                            @Html.HiddenFor(m => m.Itens[i].DevolucaoItemId)
                                            @Html.HiddenFor(m => m.Itens[i].ItemNr)
                                            @Html.HiddenFor(m => m.Itens[i].Descricao)
                                            @Html.HiddenFor(m => m.Itens[i].Quantidade)
                                            @Html.HiddenFor(m => m.Itens[i].StatusId)
                                            @Html.HiddenFor(m => m.Itens[i].StatusNome)
                                            @Html.HiddenFor(m => m.Itens[i].Observacao)
                                            <tr>
                                                <td>@itens[i].ItemNr</td>
                                                <td>@itens[i].Descricao</td>
                                                <td class="text-center">@itens[i].Quantidade</td>
                                                <td class="text-center">
                                                    @Html.TextBoxFor(m => m.Itens[i].OcorrenciaInformada, new { @class = "form-control text-center js-ocorrencia-quantidade", type = "number", min = "0", max = itens[i].Quantidade, style = "max-width:120px; display:inline-block;" })
                                                </td>
                                                <td>
                                                    @Html.DropDownListFor(
                                                        m => m.Itens[i].OcorrenciaId,
                                                        new SelectList(Model.OcorrenciaDDL, "Value", "Text", itens[i].OcorrenciaId),
                                                        new { @class = "form-control js-ocorrencia-id" })
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">Nenhum item localizado.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row devolucao-recebimento-actions">
                    <div class="col-xs-12">
                        <a href="@Url.Action("Index", "NotaFiscal", new { area = "RecebimentoApp" })" class="btn btn-primary">
                            <i class="fa fa-arrow-left"></i> Retornar
                        </a>
                        <button type="submit" class="btn btn-success pull-right">
                            <i class="fa fa-save"></i> Salvar Altera&ccedil;&otilde;es
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<script>
    (function ($) {
        function getQuantidadeProblema(row) {
            return parseInt($.trim(row.find(".js-ocorrencia-quantidade").val() || "0"), 10) || 0;
        }

        function hasProblemaInformado() {
            var hasProblema = false;
            $(".devolucao-recebimento-table tbody tr").each(function () {
                if (getQuantidadeProblema($(this)) > 0) {
                    hasProblema = true;
                    return false;
                }
            });
            return hasProblema;
        }

        function syncRowState(row) {
            var quantidade = getQuantidadeProblema(row);
            var ocorrencia = row.find(".js-ocorrencia-id");
            var enabled = quantidade > 0;
            var ocorrenciaSelecionada = parseInt($.trim(ocorrencia.val() || "0"), 10) || 0;

            ocorrencia.prop("disabled", !enabled);
            if (!enabled) {
                ocorrencia.val("");
                ocorrencia.removeClass("devolucao-recebimento-required");
            } else if (ocorrenciaSelecionada <= 0) {
                ocorrencia.addClass("devolucao-recebimento-required");
            } else {
                ocorrencia.removeClass("devolucao-recebimento-required");
            }
        }

        function syncStatusState() {
            var form = $("#devolucao-recebimento-form");
            var statusOcorrencia = (form.data("status-ocorrencia") || "").toString();
            var statusFinalizado = (form.data("status-finalizado") || "").toString();
            var hasProblema = hasProblemaInformado();

            if (hasProblema) {
                $("#StatusId").val(statusOcorrencia);
            } else if (statusFinalizado) {
                $("#StatusId").val(statusFinalizado);
            }
        }

        function syncFormState() {
            var hasPendencia = false;

            $(".devolucao-recebimento-table tbody tr").each(function () {
                var row = $(this);
                syncRowState(row);

                var quantidade = getQuantidadeProblema(row);
                var ocorrenciaId = parseInt($.trim(row.find(".js-ocorrencia-id").val() || "0"), 10) || 0;
                if (quantidade > 0 && ocorrenciaId <= 0) {
                    hasPendencia = true;
                }
            });

            syncStatusState();
            $("#StatusId").prop("disabled", true);
            $("button[type='submit']").prop("disabled", hasPendencia);
        }

        $(document).ready(function () {
            syncFormState();

            $(".js-ocorrencia-quantidade").on("change keyup", function () {
                syncFormState();
            });

            $(".js-ocorrencia-id").on("change", function () {
                syncFormState();
            });

            $("#devolucao-recebimento-form").on("submit", function (e) {
                $("#StatusId").prop("disabled", false);

                var statusId = $("#StatusId").val();
                var errors = [];

                if (!statusId) {
                    errors.push("Informe o status.");
                }

                $(".devolucao-recebimento-table tbody tr").each(function () {
                    var row = $(this);
                    var quantidadeValor = $.trim(row.find(".js-ocorrencia-quantidade").val() || "");
                    var ocorrenciaIdValor = $.trim(row.find(".js-ocorrencia-id").val() || "");
                    var quantidade = parseInt(quantidadeValor || "0", 10);
                    var maximo = parseInt(row.find(".js-ocorrencia-quantidade").attr("max") || "0", 10);
                    var ocorrenciaId = parseInt(ocorrenciaIdValor || "0", 10);

                    if (quantidade <= 0 && ocorrenciaId <= 0) {
                        return;
                    }

                    if (quantidade <= 0) {
                        errors.push("Preencha a ocorrência dos itens com problema.");
                        return false;
                    }

                    if (quantidade > maximo) {
                        errors.push("A Qtde com Problema não pode ser maior que a quantidade do item.");
                        return false;
                    }

                    if (ocorrenciaId <= 0) {
                        errors.push("Selecione a ocorrência para os itens com problema.");
                        return false;
                    }
                });

                if (errors.length > 0) {
                    $("#StatusId").prop("disabled", true);
                    e.preventDefault();
                    alert(errors[0]);
                }
            });
        });
    })(jQuery);
</script>
