@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Notas Fiscais de Transferência";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .datatable_filter {
        padding-bottom: 15px;
    }

    select.filter {
        margin-right: 15px;
        border: 1px solid #eee;
    }

    div.filter-option, a > span.text {
        font-size: 13px !important;
    }

    select.selected {
        border: 2px solid #00a65a;
    }

    th, td {
        text-align: center;
        vertical-align: middle !important;
    }

    #tbItensNF {
        table-layout: fixed;
    }

        #tbItensNF tr > td > input {
            height: 28px !important;
        }

    div.padding-r0 {
        padding-right: 0px;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">

            <div class="row">
                <div class="col-xs-12">
                    <div class="page-header" style="margin-bottom:0px;border-bottom:none;margin-top:0px;">
                        <h4 class="text-muted" style="display:inline-block;float:left"><i class="fa-solid fa-file-circle-plus"></i> Cadastrar Nota Fiscal</h4>
                        <a href="@Url.Action("Index","NotaFiscal", new { area="RecebimentoApp"})" class="btn btn-primary pull-right"> <i class="fa-solid fa-arrow-left"></i> Retornar</a>
                    </div>
                </div>
            </div>
            <div class="row form-group" id="input-danfe">
                <div class="col-xs-12 col-lg-5">
                    <div class="input-group" style="margin-top:15px">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="danfe" class="form-control" placeholder="DANFE" maxlength="44" style="font-size:14px; font-weight: bold; width: 100%;" autofocus>
                        <input type="hidden" id="input-danfe" />
                    </div>
                </div>
            </div>

            <div class="row" id="input-itemNF" style="display:none">
                <div class="col-xs-12 col-lg-2 padding-r0">
                    <div class="form-group text-center">
                        <label>CNPJ</label>
                        <p class="text-muted input-view" id="cnpj-fornecedor"></p>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-4 padding-r0">
                    <div class="form-group">
                        <label>Fornecedor</label>
                        <input type="text" class="form-control" id="nome-fornecedor-input" />
                        <p class="text-muted input-view" id="nome-fornecedor"></p>
                    </div>
                </div>

                <div class="col-xs-12 col-lg-2 padding-r0">
                    <div class="form-group text-center">
                        <label>Nota Fiscal</label>
                        <p class="text-muted input-view" id="nro-notafiscal"></p>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-2 padding-r0">
                    <div class="form-group text-center">
                        <label>Material</label>
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                            <input type="text" id="itemNotaFiscal" class="form-control text-center" placeholder="Código" style="font-size:14px; font-weight: bold">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <button type="button" class="btn btn-success" id="btnSalvar" style="display:none;"><i class="fa-solid fa-save"></i> Salvar</button>
                    <a href="#" class="btn btn-danger pull-right" id="btnReiniciar" style="display:none;"><i class="fa fa-undo"></i> Reiniciar</a>
                </div>
            </div>

            <div class="row form-group" id="itens-nf" style="display:none;">
                <div class="col-xs-12">
                    <br />
                    <div class="table-responsive">
                        <table class="table table-condensed table-bordered table-hover table-small" id="tbItensNF">
                            <thead>
                                <tr>
                                    <th class="bg-blue-gradient" style="width:5%">Item</th>
                                    <th class="bg-blue-gradient" style="width:15%">Código do Material</th>
                                    <th class="bg-blue-gradient" style="width:60%">Descrição do material</th>
                                    <th class="hide" style="width:20%">Locação</th>
                                    <th class="bg-blue-gradient" style="width:10%">Quantidade</th>
                                    <th class="bg-blue-gradient"style="width:5%"></th>
                                    <th class="hide"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function Renumerar() {
            var rows = $("#tbItensNF tbody tr").length;
            var row = 1;
            $("#tbItensNF tbody tr").each(function () {
                $(this).find('td:eq(0)').text(row + '/' + rows);
                row++;
            })
        }

        $(document).ready(function () {

            // Leitura da DANFE
            $('#danfe').on('keyup', function (event) {
                event.preventDefault();

                $('#nro-notafiscal').text('');
                $('#nome-fornecedor-input').val('');
                $('#nome-fornecedor').text('');
                $('#cnpj-fornecedor').text('');

                var input = $(this).val();
                if (event.keyCode === 13) {
                    $(this).val('');

                    let isnum = /^\d+$/.test(input);
                    if (!isnum || input.length != 44) {
                        return;
                    }

                    // Verifica se a DANFE já foi processada anteriormente
                    $.ajax({
                        type: 'GET',
                        dataType: 'json',
                        url: '@Url.Action("GetNotaFiscalByDanfe", "NotaFiscal", new { area = "RecebimentoApp"})',
                        data: { danfe: input }
                    }).done(function (response) {
                        if (response.success == true) {
                            if (response.data) {

                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-warning'>Nota Fiscal já cadastrada!</h4>";

                                swal({
                                    title: "Cadastro de Nota Fiscal Transferência",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            className: "swal-btn-info"
                                        }
                                    }
                                })

                                return;

                            } else {

                                $('#input-danfe').val(input); // salva danfe para envio no POST

                                // Obter dados do fornecedor
                                var cnpj = input.substring(6, 20);

                                $.ajax({
                                    type: 'GET',
                                    dataType: 'json',
                                    url: '@Url.Action("GetInfo", "Fornecedor", new { area = "RecebimentoApp"})',
                                    data: { cnpj: cnpj }
                                }).done(function (response) {
                                    //console.log(response.data)
                                    if (response.success == true) {
                                        if (response.data) {
                                            $('#nome-fornecedor').text(response.data.Nome);
                                            $('#nome-fornecedor-input').hide();
                                        } else {
                                            $('#nome-fornecedor').hide();
                                        }

                                        $('#input-danfe').hide();
                                        $('#nro-notafiscal').text(input.substring(26, 35));
                                        $('#cnpj-fornecedor').text(cnpj.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/g, "\$1.\$2.\$3\/\$4\-\$5"));

                                        $('#input-itemNF').show();

                                        if (response.data) {
                                            $('#itemNotaFiscal').focus();
                                        } else {
                                            $('#nome-fornecedor-input').focus();
                                        }
                                    } else {
                                        var div = document.createElement("div");
                                        div.innerHTML = "<h4 class='swal-text-error'>Não foi possível acessar o cadastro de fornecedores!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                                        swal({
                                            title: "Cadastro de Nota Fiscal Transferência",
                                            content: div,
                                            buttons: {
                                                confirm: {
                                                    visible: false
                                                },
                                                cancel: {
                                                    text: "Fechar",
                                                    className: "swal-btn-danger",
                                                    closeModal: true,
                                                    visible: true
                                                }
                                            }
                                        })
                                    }
                                }).fail(function (xhr, status, error) {
                                    var errorMessage = xhr.status + ': ' + xhr.error;
                                    var div = document.createElement("div");
                                    div.innerHTML = "<h4 class='swal-text-error'>Não foi possível acessar o cadastro de fornecedores!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                                    swal({
                                        title: "Cadastro de Nota Fiscal Transferência",
                                        content: div,
                                        buttons: {
                                            confirm: {
                                                visible: false
                                            },
                                            cancel: {
                                                text: "Fechar",
                                                className: "swal-btn-danger",
                                                closeModal: true,
                                                visible: true
                                            }
                                        }
                                    })
                                })
                            }
                        } else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Não foi possível acessar o cadastro de fornecedores!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Cadastro de Nota Fiscal Transferência",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        }
                    }).fail(function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.error;
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-error'>Não foi possível acessar o cadastro de fornecedores!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                        swal({
                            title: "Cadastro de Nota Fiscal Transferência",
                            content: div,
                            buttons: {
                                confirm: {
                                    visible: false
                                },
                                cancel: {
                                    text: "Fechar",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        })
                    })

                    // Obter cnpj do fornecedor
                    var cnpj = input.substring(6, 20);
                }
            })

            $('#tbItensNF > tbody').on('click', 'a', function (e) {
                e.preventDefault();

                swal({
                    title: "Cadastro de Nota Fiscal Transferência",
                    text: "Confirma a exclusão do item ?",
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        $(this).closest('tr').remove();
                        Renumerar();
                        if ($('#tbItensNF > tbody > tr').length < 1) {
                            $('#itens-nf').hide();
                            $('#btnSalvar').hide();
                            $('#btnReiniciar').hide();
                            $('#itemNotaFiscal').focus();
                        }
                    }
                });
            })

            // Leitura do item
            $('#itemNotaFiscal').on('keyup', function (event) {
                event.preventDefault();

                var itemNF = $(this).val();
                if (event.keyCode === 13) {
                    $(this).val('');

                    // limitar quantidade de caracteres do item ??  só aceitar números ??
                    //let isnum = /^\d+$/.test(itemNF);
                    //if (!isnum || itemNF.length != 8) {
                    //    return;
                    //}

                    var found = false;
                    $("#tbItensNF tr").each(function () {
                        var item = $(this).find('td:eq(1)').text().trim();
                        if (item == itemNF) {
                            found = true;
                            return false;
                        }
                    })

                    if (found) {
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-warning'>O material " + itemNF + " já foi informado!</h4>";

                        swal({
                            title: "Cadastro de Nota Fiscal Transferência",
                            content: div,
                            buttons: {
                                confirm: {
                                    className: "swal-btn-info"
                                }
                            }
                        })

                        return;
                    }

                    $.ajax({
                        type: 'GET',
                        dataType: 'json',
                        url: '@Url.Action("GetInfoByItem", "Home", new { area = "EstoqueApp"})',
                        data: { item: itemNF }
                    }).done(function (response) {
                        //console.log(response.data)
                        if (response.success == true) {
                            if (response.data) {
                                $('#tbItensNF > tbody').append(
                                    '<tr>' +
                                        '<td class="text-muted" style="font-size:14px"></td>' +
                                        '<td>' + itemNF + '</td>' +
                                        '<td class="text-left">' + response.data.Descricao + '</td>' +
                                        '<td class="text-left hide"><span style="margin-left:12px">' + response.data.Locacao + '</span></td>' +
                                        '<td><input type="text" class="form-control text-center integer" value="1"></input></td>' +
                                        '<td><a href="#"><i class="fa fa-lg fa-fw fa-trash-o text-red"></a></td>' +
                                        '<td class="hide"></td>' +
                                    '</tr>');

                                Renumerar();

                                setTimeout(function () {
                                    $('#tbItensNF tr:last input:last').focus();
                                }, 100)

                            } else {
                                $('#tbItensNF > tbody').append(
                                    '<tr>' +
                                        '<td class="text-muted" style="font-size:14px"></td>' +
                                        '<td>' + itemNF + '</td>' +
                                        '<td><input type="text" class="form-control"></td>' +
                                        '<td class="hide"><div id="scrollable-dropdown-menu"><input type="text" class="form-control"></div></td>' +
                                        '<td><input type="text" class="form-control text-center integer" value="1"></input></td>' +
                                        '<td><a href="#"><i class="fa fa-lg fa-fw fa-trash-o text-red"></a></td>' +
                                        '<td class="hide"></td>' +
                                    '</tr>');

                                Renumerar();

                                $('.integer:input[type="text"]').on("cut copy paste", function (e) {
                                    e.preventDefault();
                                });

                                $('.integer:input[type="text"]').on('keypress', function (e) {
                                    var ASCIICode = (e.which) ? e.which : e.keyCode
                                    if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
                                        return false;
                                    return true;
                                })

                                setTimeout(function () {
                                    $('#tbItensNF tr:last input:first').focus();
                                }, 100)

                            }
                            $('#itens-nf').show();
                            $('#btnReiniciar').show();
                            $('#btnSalvar').show();
                        } else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao acessar o cadastro de Materiais!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Cadastro de Nota Fiscal Transferência",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        }
                    }).fail(function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.error;
                        var errorMessage = xhr.status + ': ' + xhr.error;
                        var div = document.createElement("div");
                        div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao acessar o cadastro de Materiais!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                        swal({
                            title: "Cadastro de Nota Fiscal Transferência",
                            content: div,
                            buttons: {
                                confirm: {
                                    visible: false
                                },
                                cancel: {
                                    text: "Fechar",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        })
                    })
                }
            })

            // Reiniciar
            $('#btnReiniciar').click(function () {
                swal({
                    title: "Cadastro de Nota Fiscal Transferência",
                    text: "Deseja cancelar a entrada da Nota Fiscal ?",
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        $('#tbItensNF > tbody').empty();
                        $('#input-danfe').val('');
                        $('#btnSalvar').hide();
                        $('#btnReiniciar').hide();
                        $('#itens-nf').hide();
                        $('#input-itemNF').hide();
                        $('#input-danfe').show();
                        $('#danfe').focus();
                    }
                });
            })

            $('#btnSalvar').click(function () {
                var msg = '';

                // Fornecedor
                var input = $('#nome-fornecedor-input');
                if (input.is(":visible") && input.val() == '') {
                    msg = 'Informe o nome do fornecedor!';
                } else {
                    // Validar tabela
                    $('#tbItensNF tbody tr').each(function () {

                        // Descrição do item
                        //if ($(this).find('td:eq(2) input').length) {
                        //    var value = $(this).find('td:eq(2) input').val();
                        //    if (value == null || value.trim() == '') {
                        //        msg = 'Informe a descrição do item!';
                        //        input = $(this).find('td:eq(2) input');
                        //        return false;
                        //    }
                        //}

                        // Locação
                        //var value = $(this).find('td:eq(6)').text();
                        //if (value == null || value.trim() == '') {
                        //    msg = 'Informe a locação do item!';
                        //    input = $(this).find('td:eq(3) input');
                        //    return false;
                        //}

                        // Quantidade
                        var qtd = $(this).find('td:eq(4) input').val();
                        if (qtd == null || qtd.trim() == '' || Number(qtd) == 0) {
                            msg = 'Informe a quantidade do item!';
                            input = $(this).find('td:eq(4) input');
                            return false;
                        }
                    })
                }

                if (msg != '') {
                    var div = document.createElement("div");
                    div.innerHTML = "<h4 class='swal-text-warning'>" + msg + "</h4>";

                    swal({
                        title: "Cadastro de Nota Fiscal Transferência",
                        content: div,
                        buttons: {
                            confirm: {
                                className: "swal-btn-info"
                            }
                        }
                    }).then(function () {
                        $(input).get(0).focus();
                    });

                    return;
                }

                swal({
                    title: "Cadastro de Nota Fiscal Transferência",
                    text: "Confirma a entrada da Nota Fiscal ?",
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        var notafiscal = [];

                        if ($('#nome-fornecedor-input').is(":visible")) {
                            var add_fornecedor = true;
                            var nome_fornecedor = $('#nome-fornecedor-input').val().trim();
                        } else {
                            var add_fornecedor = false;
                            var nome_fornecedor = '';
                        }

                        $('#tbItensNF tbody tr').each(function () {
                            var item = {};

                            item.Filial = $('#cnpj-fornecedor').text().trim().trim().replace(/\D/g, '');
                            item.AddFornecedor = add_fornecedor;
                            item.NomeFilial = nome_fornecedor;

                            item.NumeroNF = $('#nro-notafiscal').text();
                            item.Danfe = $('#input-danfe').val();
                            item.ItemNr = $(this).find('td:eq(1)').text().trim();

                            if ($(this).find('td:eq(2) input').length) {
                                item.Descricao = $(this).find('td:eq(2) input').val();
                            } else {
                                item.Descricao = $(this).find('td:eq(2)').text().trim();
                            }

                            //item.Locacao = $(this).find('td:eq(6)').text().trim();
                            item.Quantidade = $(this).find('td:eq(4) input').val();
                            notafiscal.push(item);
                        });

                        console.log(notafiscal);

                        $.ajax({
                            url: '@Url.Action("Transferencia", "NotaFiscal", new { area = "RecebimentoApp"})',
                            type: 'POST',
                            dataType: 'json',
                            contentType: 'application/json',
                            data: JSON.stringify(notafiscal),
                        }).done(function (response) {
                            //console.log(response)
                        }).fail(function (xhr, status, error) {
                            var errorMessage = xhr.status + ': ' + xhr.error;
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao gravar a Nota Fiscal!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                            swal({
                                title: "Cadastro de Nota Fiscal Transferência",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        })

                        $('#tbItensNF > tbody').empty();
                        $('#btnSalvar').hide();
                        $('#btnReiniciar').hide();
                        $('#itens-nf').hide();

                        $('#input-itemNF').hide();
                        $('#input-danfe').show();
                        $('#danfe').focus();

                        swal({
                            title: "Cadastro de Nota Fiscal Transferência",
                            text: "Nota Fiscal cadastrada com sucesso!",
                            buttons: false,
                            timer: 2000,
                            //closeOnClickOutside: true,
                            //closeOnEsc: true,
                            //buttons: {
                            //    confirm: {
                            //        className: "swal-btn-info"
                            //    }
                            //}
                            //buttons: {
                            //    cancel: {
                            //        text: "Não",
                            //        className: "swal-btn-danger",
                            //        closeModal: true,
                            //        visible: true,
                            //    },
                            //    confirm: {
                            //        text: "Sim",
                            //        className: "swal-btn-success",
                            //        closeModal: true,
                            //        visible: true
                            //    }
                            //}
                        });
                        @*}).then((confirm) => {
                            if (confirm) {

                            } else {
                                var url = '@Url.Action("Index","NotaFiscal", new { area = "RecebimentoApp"})'
                            }
                        });*@
                    }
                });

            })

        });
    </script>
}
