
@{
    ViewBag.Title = "Recebimento";
    ViewBag.Description = "Impressão de Etiquetas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />


<style>
    .datatable_filter {
        padding-bottom: 15px;
    }

    select.filter {
        margin-right: 15px;
        border: 1px solid #eee;
    }

    div.filter-option, a > span.text {
        font-size: 13px !important;
    }

    select.selected {
        border: 2px solid #00a65a;
    }

    th, td {
        text-align: center;
        vertical-align: middle;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">

            <div class="row">
                <div class="col-xs-12 col-lg-1">
                    <div class="form-group">
                        <label>Etiquetas</label>
                        <select class="form-control">
                            <option>1</option>
                            <option>2</option>
                            <option>3</option>
                            <option>4</option>
                            <option>5</option>
                            <option>6</option>
                            <option>7</option>
                            <option>8</option>
                            <option>9</option>
                            <option>10</option>
                        </select>
                    </div>
                </div>

                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label>Item Nr</label>
                        <input type="text" class="form-control" placeholder="Item Nr...">
                    </div>
                </div>

                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label>Volume Nr</label>
                        <input type="text" class="form-control" placeholder="Volume Nr...">
                    </div>
                </div>

                <div class="col-xs-12 col-lg-2">
                    <div class="form-group">
                        <div class="form-check" style="margin-top:30px">
                            <input class="form-check-input" type="checkbox" />
                            <label class="form-check-label">&nbsp;&nbsp;Estoque Zero</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {

    <script>

        $(document).ready(function () {


        });
    </script>
}