
@{
    ViewBag.Title = "Expedição";
    ViewBag.Description = "Importar arquivo de Notas Fiscais";

    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/jquery-filestyle/jquery-filestyle.min.css" rel="stylesheet" />

<style>
    select.selected {
        border: 2px solid #00a65a;
    }

    th, td {
        text-align: center;
        vertical-align: middle !important;
    }

    th {
        white-space: nowrap;
    }

    div.jfilestyle.jfilestyle-theme-quasar input {
        border: none;
        background: #eee;
    }

    div.jfilestyle.jfilestyle-theme-quasar label {
        border: none;
        background: #3c8dbc;
        color: #fff;
    }

    .last-update {
        font-size: 14px !important;
        margin-top: 5px !important;
        margin-right: 10px !important;
    }

    #scrollable-dropdown-menu .tt-menu {
        max-height: 200px;
        overflow-y: auto;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">

        <div class="box-body">
            <p id="processing">Loading...</p>
            <div class="data-container hide">
                <div class="row">
                    <div class="col-xs-12 col-lg-8">
                        <div class="form-group">
                            <label class="text-muted">Importar arquivo de Notas Fiscais</label>
                            <div>
                                <input type="file" id="uploadarquivo" class="jfilestyle"
                                       data-theme="quasar"
                                       data-text="<i class='fa-solid fa-folder'></i> Selecionar"
                                       data-buttonBefore="true"
                                       data-inputSize="300px"
                                       data-placeholder="Nenhum arquivo selecionado">
                                <button type="button" id="btn-importar-arquivo" class="btn btn-success hide" style="margin-left:5px">
                                    <i class="fa fa-fw fa-upload"></i> Importar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-condensed table-bordered table-hover table-small" id="tbNotaFiscal" style="font-size:13px"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>
    <script src="~/Scripts/DataTables/plugins/sorting/datetime-moment.js"></script>
    <script src="~/Scripts/jquery-filestyle/jquery-filestyle.min.js"></script>

    <script>
        function LoadDataTable() {
            $.fn.dataTable.moment('DD/MM/YYYY HH:mm:ss');

            $('#processing').removeClass('hide');
            $('.data-container').addClass('hide');

            $.fn.dataTable.moment('DD/MM/YYYY HH:mm:ss');

            if ($.fn.DataTable.isDataTable('#tbNotaFiscal')) {
                $('#tbNotaFiscal').DataTable().destroy();
            }

            $('#tbNotaFiscal tbody').empty();
            var action = '@Url.Action("GetData", "NotaFiscal", new { area = "ExpedicaoApp" })';

            var table = $('#tbNotaFiscal').DataTable({
                deferRender: true,
                serverSide: true,
                processing: true,
                autoWidth: false,
                pageLength: 25,
                order: [],
                ajax: {
                    url: action,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: function (d) { return JSON.stringify(d); }
                },
                columns: [
                            {
                                data: 'Numero', title: 'Nota Fiscal', render: function (data, type, row) {
                                    return '<a href="#" class="historico" data-id="' + row.Id + '">' + data + '</a>';
                                }
                            },
                           { data: 'Vendedor', title: 'Vendedor' },
                           { data: 'NomeCliente', title: 'Cliente' },
                           { data: 'ModificadoPor', title: 'Usuário' },
                           {
                                data: null, name: 'btnActions', render: function (data, type, row) {
                                    var btnGroup = '<div class="btn-group">' +
                                        '<a href="#" class="btn btn-xs btn-default btn-cancel" data-id="' + row.Id + '"><i class="fa fa-lg fa-times text-red"></i></a>' +
                                       '</div>';

                                    return btnGroup;
                                }

                           }
                ],

                columnDefs: [{ 'targets': [-1], 'orderable': false }],

                drawCallback: function () {
                    // console.log("drawCallback");
                },
                fnInitComplete: function () {
                    // console.log('fnInitComplete')
                    $('#processing').addClass('hide');
                    $('.data-container').removeClass('hide');
                },
                language: {
                    processing: "Carregando dados...",
                    lengthMenu: "Exibir _MENU_ itens por página",
                    search: "Procurar:",
                    zeroRecords: "Nenhum item encontrado",
                    info: "Exibindo _START_ de _END_ de um total de _TOTAL_ itens",
                    infoEmpty: "Exibindo 0 de 0 itens",
                    infoFiltered: "",
                    thousands: ".",
                    decimal: ",",
                    paginate: {
                        first: "Primeira",
                        last: "Última",
                        next: "Próxima",
                        previous: "Anterior"
                    }
                }
            });

            table.columns.adjust().draw(false);
        }

        $(document).ready(function () {

            LoadDataTable();

            $('#uploadarquivo').on('change', function (ev) {
                if ($(this).get(0).files.length === 0) {
                    $('#btn-importar-arquivo').addClass('hide');
                    $('#check-arquivo').addClass('hide');
                } else {
                    $('#btn-importar-arquivo').removeClass('hide');
                    $('#check-arquivo').removeClass('hide');
                }
            });

            $('#btn-importar-arquivo').click(function (e) {
                e.preventDefault();

                if ($("#uploadarquivo").val() != '') {
                    var msg = 'Confirma a importação do arquivo ?';

                    swal({
                        title: "Atualizar Notas Fiscais de Expedição",
                        text: "Confirma a importação do arquivo ?",
                        buttons: {
                            cancel: {
                                text: "Não",
                                className: "swal-btn-danger",
                                closeModal: true,
                                visible: true,
                            },
                            confirm: {
                                text: "Sim",
                                className: "swal-btn-success",
                                closeModal: true,
                                visible: true
                            }
                        }
                    }).then((confirm) => {
                        if (confirm) {
                            $('#btn-importar-arquivo').html("<i class='fa fa-fw fa-pulse fa-spinner'></i> Importando arquivo...");

                            var fileUpload = $("#uploadarquivo").get(0);
                            var files = fileUpload.files;
                            var form = new FormData();
                            form.append("Arquivo", files[0]);
                            //console.log(files[0]);
                            //console.log("AAAAAAAAA");

                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("UploadFile", "NotaFiscal", new { area = "ExpedicaoApp" })',
                                contentType: false,
                                processData: false,
                                data: form,
                            }).done(function (response) {
                                $('#btn-importar-arquivo').html("<i class='fa fa-fw fa-upload'></i> Importar");
                                if (response.erro == false) {

                                    setTimeout(function () {
                                        LoadDataTable();

                                        var div = document.createElement("div");
                                        div.innerHTML = "<h4 class='swal-text-success'>Arquivo importado com sucesso!</h4>";

                                        swal({
                                            title: "Atualizar Notas Fiscais de Expedição",
                                            content: div,
                                            buttons: {
                                                confirm: {
                                                    className: "swal-btn-info"
                                                }
                                            }
                                        })
                                    }, 300);
                                } else {
                                    var div = document.createElement("div");
                                    div.innerHTML = "<h4 class='swal-text-error'>Não foi possível importar o arquivo selecionado!</h4><p class='swal-text-error-detail'>" + response.mensagem + "</p>";
                                    swal({
                                        title: "Atualizar Notas Fiscais de Expedição",
                                        content: div,
                                        buttons: {
                                            confirm: {
                                                visible: false
                                            },
                                            cancel: {
                                                text: "Fechar",
                                                className: "swal-btn-danger",
                                                closeModal: true,
                                                visible: true
                                            }
                                        }
                                    })
                                }
                            }).fail(function (jqXHR, textStatus, errorThrown) {
                                $('#btn-importar-arquivo').html("<i class='fa fa-fw fa-upload'></i> Importar");
                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-error'>Não foi possível importar o arquivo selecionado!</h4><p class='swal-text-error-detail'>" + jqXHR + "</p>";
                                swal({
                                    title: "Atualizar Notas Fiscais de Expedição",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            visible: false
                                        },
                                        cancel: {
                                            text: "Fechar",
                                            className: "swal-btn-danger",
                                            closeModal: true,
                                            visible: true
                                        }
                                    }
                                });
                            });
                        }
                    });
                }
            });

            $('#tbNotaFiscal').on('click', 'a.historico', function (e) {
                e.preventDefault();

                var id = $(this).data('id');
                var url = '@Url.Action("Historico", "NotaFiscal", new { area = "ExpedicaoApp", id = "_id" })';
                $('#myModalContent').load(url.replace('_id', id), function () {
                    $('#myModal').modal({
                        backdrop: 'static',
                        keyboard: true
                    }, 'show');
                });
            });

            $('#tbNotaFiscal').on('click', 'a.btn-cancel', function (e) {
                var tr = $(this).closest('tr');
                var rowData = $('#tbNotaFiscal').DataTable().row(tr).data();
                swal({
                    title: "Deletar Nota Fiscal",
                    text: "Deletar nota fiscal de numero " + rowData.Numero + "?",
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            claoseModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        var notaId = $(this).data('id');
                        console.log(notaId);

                        $.ajax({
                            type: 'POST',
                            dataType: 'json',
                            url: '@Url.Action("DeleteDanfe", "NotaFiscal", new { area = "ExpedicaoApp"})',
                            data: { id: notaId }
                        }).done(function (response) {
                            if (response.success) {
                                swal({
                                    title: "Deletar Nota Fiscal",
                                    text: "Nota Fiscal deletada com sucesso!",
                                    buttons: false,
                                    timer: 1000,
                                }).then(function () {
                                    $('#tbNotaFiscal').DataTable().ajax.reload();
                                });
                            } else {
                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-error'>" + response.msg + "</h4>";
                                swal({
                                    title: "Deletar Nota Fiscal",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            visible: false
                                        },
                                        cancel: {
                                            text: "Fechar",
                                            className: "swal-btn-danger",
                                            closeModal: true,
                                            visible: true
                                        }
                                    }
                                })
                            }
                        }).fail(function (xhr, status, error) {
                            var errorMessage = xhr.status + ': ' + xhr.error;
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao cancelar o lançamento da Nota Fiscal!</h4><p class='swal-text-error-detail'>" + errorMessage + "</p>";
                            swal({
                                title: "Cancelar Lançamento de Nota Fiscal",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            })
                        })
                    }

                });

            });
        });
    </script>
}
