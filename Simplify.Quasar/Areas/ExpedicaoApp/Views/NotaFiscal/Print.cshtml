@model Simplify.Quasar.Areas.ExpedicaoApp.ViewModels.NotaFiscalViewModel

@{
    ViewBag.Title = "Expedição";
    ViewBag.Description = "Imprimir Etiquetas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .toolbar-panel {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: flex-start;
        min-height: 74px;
    }

    .toolbar-panel .form-group {
        margin-bottom: 8px;
        text-align: right;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">

    <div class="box box-default">

        <div class="box-body">
            <input type="hidden" id="imprimir-direto" value="@Model.ImprimirDireto.ToString().ToLowerInvariant()" />
            <input type="hidden" id="ps-ip" value="@Model.PrinterServerIP" />
            <input type="hidden" id="ps-port" value="@Model.PrinterServerPort" />
            <input type="hidden" id="printer-name" value="@Model.ImpressoraPadraoNome" />
            <input type="hidden" id="printer-ip" value="@Model.ImpressoraPadraoIP" />
            <input type="hidden" id="printer-port" value="@Model.ImpressoraPadraoPorta" />
            @if (Model.ImprimirDireto)
            {
                <iframe src="" id="direct-label-print-frame" title="Servidor de impressão"
                        style="display:none; width:0; height:0; border:0;"></iframe>
            }
            <div class="row">
                <div class="col-xs-12 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="fa fa-lg fa-barcode"></i></span>
                        <input type="text" id="danfe" class="form-control" placeholder="DANFE" maxlength="44" style="font-size:14px; font-weight: bold; width: 100%;">
                    </div>
                </div>
                <div class="col-xs-12 col-lg-7">
                    <div class="toolbar-panel">
                        <div class="form-group">
                            <label class="text-muted">Método de impressão</label>
                            <p class="form-control-static">@(Model.ImprimirDireto ? "Automático" : "Manual")</p>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-lg-12 col-sm-12">
                    <div class="col-xs-12 col-lg-5">
                        <label>Transportadora</label>
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-lg fa-truck-moving"></i></span>
                            <input type="text" id="transportadoraInput" class="form-control" readonly stylestyle="font-size:14px; font-weight: bold; width: 100%;">
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <label style="margin-left: 14px;">Volumes</label>
            <div class="row">
                <div class="col-lg-6 col-xs-12">
                    <div class="col-xs-12 col-lg-3">
                        <div class="form-group">
                            <input type="number" id="qtdMinVolumes" class="form-control" value="1" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-lg-1">
                        <p>até</p>
                    </div>
                    <div class="col-lg-3 col-xs-12">
                        <div class="form-group">
                            <input type="number" id="qtdMaxVolumes" class="form-control" placeholder="MAX" />
                        </div>
                    </div>
                </div>
            </div>
            <div id="divImprimir" class="row hide">
                <div class="col-xs-12">
                    <div class="col-xs-12">
                        <a href="#" class="btn btn-success" id="btnImprimir"><i class="fa fa-fw fa-print"></i> Imprimir</a>
                    </div>
                </div>
            </div>
        </div>
    </div>


</section>

@section Scripts {
    <script>
        var imprimirDireto = ($('#imprimir-direto').val() || '').toLowerCase() === 'true';

        function ExibirResultadoImpressao(titulo, mensagem, sucesso) {
            swal({
                title: titulo,
                text: mensagem,
                icon: sucesso ? "success" : "error",
                button: "Fechar"
            });
        }

        function EnviarZplDireto(zpl) {
            var deferred = $.Deferred();
            var servidorIp = $.trim($('#ps-ip').val() || '');
            var servidorPorta = $.trim($('#ps-port').val() || '');
            var impressoraNome = $.trim($('#printer-name').val() || '');
            var impressoraIp = $.trim($('#printer-ip').val() || '');
            var impressoraPorta = $.trim($('#printer-port').val() || '');
            var iframe = document.getElementById('direct-label-print-frame');
            var finalizado = false;

            function rejeitar(mensagem) {
                if (finalizado) {
                    return;
                }
                finalizado = true;
                $('#direct-label-print-frame').off('.directLabelPrint');
                deferred.reject(mensagem);
            }

            if (!zpl) {
                rejeitar('O ZPL não foi gerado para impressão.');
                return deferred.promise();
            }
            if (!servidorIp || !servidorPorta) {
                rejeitar('Servidor de impressão não configurado.');
                return deferred.promise();
            }
            if (!impressoraNome || !impressoraIp || !impressoraPorta || impressoraPorta === '0') {
                rejeitar('A impressora padrão não está configurada corretamente.');
                return deferred.promise();
            }
            if (!iframe) {
                rejeitar('Não foi possível preparar o envio ao servidor de impressão.');
                return deferred.promise();
            }

            var $iframe = $('#direct-label-print-frame');
            var timeoutId = window.setTimeout(function () {
                rejeitar('Não foi possível conectar ao servidor de impressão.');
            }, 30000);

            $iframe.off('.directLabelPrint').one('load.directLabelPrint', function () {
                window.setTimeout(function () {
                    if (finalizado) {
                        return;
                    }

                    try {
                        if (!iframe.contentWindow) {
                            window.clearTimeout(timeoutId);
                            rejeitar('Não foi possível acessar o servidor de impressão.');
                            return;
                        }

                        iframe.contentWindow.postMessage(JSON.stringify({
                            ipServidorImpressao: servidorIp,
                            portaServidorImpressao: servidorPorta,
                            nomeImpressora: impressoraNome,
                            ipImpressora: impressoraIp,
                            portaImpressora: impressoraPorta,
                            comandosZPL: zpl
                        }), '*');

                        finalizado = true;
                        window.clearTimeout(timeoutId);
                        $iframe.off('.directLabelPrint');
                        deferred.resolve();
                    } catch (e) {
                        window.clearTimeout(timeoutId);
                        rejeitar('Não foi possível enviar o ZPL ao servidor de impressão: ' + (e.message || e.toString()));
                    }
                }, 3000);
            });

            iframe.src = 'https://' + servidorIp + ':' + servidorPorta
                + '/quasardealer/impressora/iframeImpressao?_=' + new Date().getTime();

            return deferred.promise();
        }

        function CarregarEtiquetaManual(notaFiscal, minVolume, maxVolume) {
            var deferred = $.Deferred();
            var iframe = document.getElementById('manual-label-print-frame');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'manual-label-print-frame';
                iframe.setAttribute('title', 'Etiquetas de expedição');
                iframe.style.position = 'fixed';
                iframe.style.left = '-10000px';
                iframe.style.top = '0';
                iframe.style.width = '1px';
                iframe.style.height = '1px';
                iframe.style.border = '0';
                iframe.style.opacity = '0';
                iframe.style.pointerEvents = 'none';
                document.body.appendChild(iframe);
            }

            var completed = false;
            var $iframe = $(iframe);
            var timeoutId = window.setTimeout(function () {
                if (!completed) {
                    completed = true;
                    $iframe.off('.manualLabelPrint');
                    deferred.reject('Tempo limite ao preparar as etiquetas para impressão.');
                }
            }, 30000);

            $iframe.off('.manualLabelPrint').one('load.manualLabelPrint', function () {
                if (completed) {
                    return;
                }

                try {
                    var printDocument = iframe.contentDocument || iframe.contentWindow.document;
                    if (!printDocument || !printDocument.getElementById('manual-label-document')) {
                        completed = true;
                        window.clearTimeout(timeoutId);
                        $iframe.off('.manualLabelPrint');
                        deferred.reject('Nenhuma etiqueta foi localizada para impressão manual.');
                        return;
                    }

                    completed = true;
                    window.clearTimeout(timeoutId);
                    $iframe.off('.manualLabelPrint');
                    deferred.resolve(iframe);
                } catch (e) {
                    completed = true;
                    window.clearTimeout(timeoutId);
                    $iframe.off('.manualLabelPrint');
                    deferred.reject(e.message || e.toString());
                }
            });

            var url = '@Url.Action("PrintExpedicaoManual", "NotaFiscal", new { area = "ExpedicaoApp" })';
            iframe.src = url
                + '?key=' + encodeURIComponent(notaFiscal)
                + '&minVolume=' + encodeURIComponent(minVolume)
                + '&maxVolume=' + encodeURIComponent(maxVolume)
                + '&_=' + new Date().getTime();

            return deferred.promise();
        }

        function AbrirDialogoImpressaoManual(iframe) {
            window.setTimeout(function () {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            }, 250);
        }

        $('#btnImprimir').click(function (event) {
            event.preventDefault();
            var notaFiscal = $('#danfe').val();
            var qtdMinVolumes = $('#qtdMinVolumes').val();
            var qtdMaxVolumes = $('#qtdMaxVolumes').val();


            if (notaFiscal) {
                if (qtdMinVolumes) {
                    if (qtdMaxVolumes) {
                        /*
                         * Confirmacao desativada: a impressao deve seguir
                         * diretamente para o preview e escolha da impressora.
                         * Manter este bloco comentado para eventual uso futuro.
                        swal({
                            title: "Imprimir",
                            text: "Confirmar impressão dos volumes " + qtdMinVolumes + " à " + qtdMaxVolumes + " da nota fiscal " + notaFiscal + "?",
                            buttons: {
                                cancel: {
                                    text: "Não",
                                    className: "swal-btn-danger",
                                    closeModal: true,
                                    visible: true,
                                },
                                confirm: {
                                    text: "Sim",
                                    className: "swal-btn-success",
                                    closeModal: true,
                                    visible: true
                                }
                            }
                        }).then((confirm) => {
                            if (confirm) {
                        */
                                $.ajax({
                                    type: 'GET',
                                    dataType: 'json',
                                    url: '@Url.Action("GetDataToPrintVolume", "NotaFiscal", new { area = "ExpedicaoApp"})',
                                    data: {
                                        key: notaFiscal,
                                        minVolume: qtdMinVolumes,
                                        maxvolume: qtdMaxVolumes,
                                        somenteValidar: true
                                    }
                                }).done(function (response) {
                                    if (response.success) {
                                        if (imprimirDireto) {
                                            $.ajax({
                                                type: 'GET',
                                                dataType: 'json',
                                                url: '@Url.Action("GetDataToPrintVolume", "NotaFiscal", new { area = "ExpedicaoApp"})',
                                                data: {
                                                    key: notaFiscal,
                                                    minVolume: qtdMinVolumes,
                                                    maxvolume: qtdMaxVolumes,
                                                    somenteValidar: false
                                                }
                                            }).done(function (printResponse) {
                                                if (!printResponse.success || !printResponse.etiquetas || !printResponse.etiquetas.length) {
                                                    ExibirResultadoImpressao(
                                                        'Erro na impressão',
                                                        printResponse.msg || 'Nenhuma etiqueta foi gerada para impressão.',
                                                        false);
                                                    return;
                                                }

                                                EnviarZplDireto(printResponse.etiquetas.join(''))
                                                    .fail(function (msg) {
                                                        ExibirResultadoImpressao('Erro na impressão', msg, false);
                                                    });
                                            }).fail(function (xhr) {
                                                ExibirResultadoImpressao(
                                                    'Erro na impressão',
                                                    (xhr.responseJSON && xhr.responseJSON.msg)
                                                        || xhr.statusText
                                                        || 'Não foi possível gerar as etiquetas.',
                                                    false);
                                            });
                                        } else {
                                            CarregarEtiquetaManual(notaFiscal, qtdMinVolumes, qtdMaxVolumes)
                                                .done(function (iframe) {
                                                    AbrirDialogoImpressaoManual(iframe);
                                                })
                                                .fail(function (msg) {
                                                    ExibirResultadoImpressao('Erro na impressão', msg, false);
                                                });
                                        }

                                    } else {
                                        var div = document.createElement("div");
                                        div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao processar a solicitação!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                                        swal({
                                            title: "Processar Notas Fiscais",
                                            content: div,
                                            buttons: {
                                                confirm: {
                                                    visible: false
                                                },
                                                cancel: {
                                                    text: "Fechar",
                                                    className: "swal-btn-danger",
                                                    closeModal: true,
                                                    visible: true
                                                }
                                            }
                                        }).then(function () {
                                            console.log("erro")
                                        });

                                    }

                                }).fail(function (xhr, status, error) {
                                    var errorMessage = xhr.status + ': ' + xhr.statusText
                                    alert(errorMessage)
                                })
                        /*
                            }
                        })
                        */
                    }
                    else {
                        alert('Quantidade máxima de volumes precisa ser diferente de nulo!');
                    }

                }
                else {
                    alert('Quantidade mímina de volumes precisa ser diferente de nulo!');
                }
            } else {
                alert('Nota fiscal não pode ser nula!');
            }



        })

        $('#danfe').on('keyup', function (event) {
            event.preventDefault();
            var input = $(this).val();

            if (event.keyCode === 13) {
                //$(this).val('');
                let isnum = /^\d+$/.test(input);
                if (isnum) {
                    $.ajax({
                        type: 'GET',
                        dataType: 'json',
                        url: '@Url.Action("GetDanfeInfo", "NotaFiscal", new { area = "ExpedicaoApp"})',
                        data: { key: input }
                    }).done(function (response) {
                        if (response.success == true) {
                            $('#danfe').val(input);
                            $('#transportadoraInput').val(response.transportadora.Nome_Fantasia);
                            $('#qtdMaxVolumes').val(response.notaFiscal.QtdVolumes);
                            $('#divImprimir').removeClass('hide');
                        }
                        else {
                            var div = document.createElement("div");
                            div.innerHTML = "<h4 class='swal-text-error'>Ocorreu um erro ao processar a solicitação!</h4><p class='swal-text-error-detail'>" + response.msg + "</p>";
                            swal({
                                title: "Finalizar Lançamento de Nota Fiscal",
                                content: div,
                                buttons: {
                                    confirm: {
                                        visible: false
                                    },
                                    cancel: {
                                        text: "Fechar",
                                        className: "swal-btn-danger",
                                        closeModal: true,
                                        visible: true
                                    }
                                }
                            });
                        }
                    }) 
                }

            }
        });
    </script>

}


