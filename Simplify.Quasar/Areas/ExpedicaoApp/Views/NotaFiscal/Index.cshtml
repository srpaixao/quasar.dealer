        function ProcessNextPrint(arr_etiquetas_next) {
            const nextItem = arr_etiquetas_next.shift()
            //const nextItem = arr_etiquetas.shift()
            if (nextItem) {
                isFunctionRunning = true;
                ImprimirEtiqueta(nextItem, arr_etiquetas_next);
            } else {
                isFunctionRunning = false;
               // location.reload();
            }
        }

        function ImprimirEtiqueta(zpl, arr_etiquetas_print) {
            var printer_ip = $('#ip').val();
            var printer_port = $('#porta').val();

            if (printer_ip && printer_port && zpl) {
                var url = "https://" + ps_ip + ":" + ps_port + "/quasardealer/impressora/iframeImpressao";

                //var now = new Date();
                //var currentDateTime = now.toLocaleString();
                //console.log(currentDateTime, 'Carregando o iframe...')
                $("#dummyframe").attr("src", url);

                setTimeout(function () {
                    //var now = new Date();
                    //var currentDateTime = now.toLocaleString();
                    //console.log(currentDateTime, 'Iframe carregado')
                    var iframeWin = document.getElementById("dummyframe").contentWindow;
                    var mensagem = JSON.stringify({
                        ipServidorImpressao: ps_ip,
                        portaServidorImpressao: ps_port,
                        ipImpressora: printer_ip,
                        portaImpressora: printer_port,
                        comandosZPL: zpl
                    });

                    try {
                        iframeWin.postMessage(mensagem, "*");
                        $.ajax({
                            type: 'POST',
                            dataType: 'json',
                            url: '@Url.Action("LogPrintZpl", "NotaFiscal", new { area = "ExpedicaoApp"})',
                            data: { zpl: zpl }
                        }).done(function (response) {
                            if (!response.success) {
                                alert(response.msg);
                            }
                        })
                    } catch (e) {
                        console.log(e);
                    }

                    //setTimeout(function () {
                    //    ProcessNextPrint(arr_etiquetas_print);
                    //}, 700);
                }, 700)
            }
        }

        function ImprimirEtiquetaAll(zpl) {
            var printer_ip = $('#ip').val();
