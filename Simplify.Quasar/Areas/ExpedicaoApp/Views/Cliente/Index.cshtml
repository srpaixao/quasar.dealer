@model IEnumerable<Simplify.Quasar.Areas.ExpedicaoApp.ViewModels.ClienteViewModel>
@{
    ViewBag.Title = "Expedição";
    ViewBag.Description = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .datatable_filter {
        padding-bottom: 15px;
    }

    select.filter {
        margin-right: 15px;
        border: 1px solid #eee;
    }

    div.filter-option, a > span.text {
        font-size: 13px !important;
    }

    select.selected {
        border: 2px solid #00a65a;
    }

    th, td {
        text-align: center;
        vertical-align: middle;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">

        <div class="box-body">
            @if (ViewBag.Permissoes.Contains("[add]"))
            {
                <div class="row">
                    <div class="col-xs-12">
                        <a href="#" class="btn btn-primary create"> <i class="fa fa-fw fa-plus"></i> Novo</a>
                        @*<a href="#" class="btn btn-primary imprimir"> <i class="fa fa-fw fa-print"></i> Imprimir Lista de Clientes</a>*@
                    </div>
                </div>
            }
            <br />
            <div class="row">
                <div class="col-xs-12">
                    <div class="table-responsive">
                        <table id="tbCliente" class="table table-condensed table-bordered table-striped display responsive nowrap" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Cidade</th>
                                    <th>Estado</th>
                                    <th>Transportadora</th>
                                    <th>Rota</th>
                                    <th>Parada</th>
                                    <th>Etiqueta</th>
                                    <th>CPF/CNPJ</th>
                                    @if (ViewBag.Permissoes.Contains("[delete]"))
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>

    <script src="~/Scripts/moment/moment.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            var podeAlterar = @(ViewBag.Permissoes.Contains("[update]") ? "true" : "false");

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : value).html();
            }

            var table = $('#tbCliente').DataTable({
                processing: true,
                deferRender: true,
                serverSide: true,
                autoWidth: false,
                pageLength: 25,
                order: [[0, 'asc']],
                ajax: {
                    url: '@Url.Action("GetData", "Cliente", new { area = "ExpedicaoApp" })',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: function (d) { return JSON.stringify(d); }
                },
                columns: [
                    {
                        data: 'Nome',
                        render: function (data, type, row) {
                            var nome = escapeHtml(data);
                            return podeAlterar
                                ? '<a href="#" class="edit" data-id="' + row.Id + '">' + nome + '</a>'
                                : nome;
                        }
                    },
                    { data: 'Endereco_Cidade', defaultContent: '' },
                    { data: 'Endereco_UF', defaultContent: '' },
                    { data: 'NomeTransportadora', defaultContent: '' },
                    { data: 'NomeRota', defaultContent: '' },
                    { data: 'NomeParada', defaultContent: '' },
                    {
                        data: 'Etiqueta',
                        render: function (data) { return data ? 'Sim' : 'Não'; }
                    },
                    { data: 'CNPJ', defaultContent: '' }
                    @if (ViewBag.Permissoes.Contains("[delete]"))
                    {
                        <text>,
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row) {
                                return '<a href="#" class="delete" data-id="' + row.Id + '"><i class="fa fa-lg fa-trash-o text-red"></i></a>';
                            }
                        }</text>
                    }
                ],
                language: {
                    processing: "Carregando dados...",
                    lengthMenu: "Exibir _MENU_ registros por página",
                    search: "Procurar:",
                    zeroRecords: "Nenhum registro localizado",
                    info: "Exibindo de _START_ a _END_ de um total de _TOTAL_ registros",
                    infoEmpty: "Exibindo 0 de 0 registros",
                    infoFiltered: "",
                    thousands: ".",
                    decimal: ",",
                    paginate: {
                        first: "Primeira",
                        last: "Última",
                        next: "Próxima",
                        previous: "Anterior"
                    }
                }
            });

            $.ajaxSetup({ cache: false });

            $("a.create").click(function () {
                if (!$('div.modal-dialog').hasClass('modal-lg')) {
                    $('div.modal-dialog').addClass('modal-lg');
                }

                var url = '@Url.Action("Create", "Cliente", new { area = "ExpedicaoApp"})';
                $('#myModalContent').load(url, function () {
                    $('#myModal').modal({
                        backdrop: 'static',
                        keyboard: true
                    }, 'show');
                    bindForm(this);
                });
                return false;

            });
           
            $("a.imprimir").click(function () {
                var url = '@Url.Action("ImprimirLista", "Cliente", new { area = "ExpedicaoApp"})';
                console.log(url);    
                window.open(url, '_blank');   
            })

            
            $("#tbCliente").on("click", "a.edit", function (e) {
                if (!$('div.modal-dialog').hasClass('modal-lg')) {
                    $('div.modal-dialog').addClass('modal-lg');
                }
                var id = $(this).attr("data-id");
                var url = '@Url.Action("Edit", "Cliente", new { area = "ExpedicaoApp" , id = "_id" })';
                $('#myModalContent').load(url.replace("_id", id), function () {
                    $('#myModal').modal({
                        backdrop: 'static',
                        keyboard: true
                    }, 'show');
                    bindForm(this);
                });
                return false;
            });

            
            $("#tbCliente").on("click", "a.delete", function (e) {
                var clienteId = $(this).attr("data-id");
                var cliente = $(this).closest('tr').find('td:eq(0)').text().trim();

                var div = document.createElement("div");
                div.innerHTML = "<span>Confirma a exclusão do cliente <b>" + cliente + "</b> ?</span>";
                swal({
                    title: "Cadastro de Clientes",
                    content: div,
                    buttons: {
                        cancel: {
                            text: "Não",
                            className: "swal-btn-danger",
                            closeModal: true,
                            visible: true,
                        },
                        confirm: {
                            text: "Sim",
                            className: "swal-btn-success",
                            closeModal: true,
                            visible: true
                        }
                    }
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: '@Url.Action("Delete", "Cliente", new { area = "ExpedicaoApp"})',
                            data: { id: clienteId },
                        success: function (data) {
                            location.reload();
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            console.log('erro');
                        }
                    })
                    }
                });
            });

            function bindForm(dialog) {
                $('form', dialog).submit(function () {
                    $.ajax({
                        url: this.action,
                        type: this.method,
                        data: $(this).serialize(),
                        success: function (result) {
                            if (result.success) {
                                $('#myModal').modal('hide');
                                //Refresh
                                location.reload();
                            } else {
                                $('#myModalContent').html(result);
                                bindForm();
                            }
                        },
                        error: function (data) {
                            console.log('erro', data);
                        }
                    });
                    return false;
                });
            }
        });
    </script>
}

