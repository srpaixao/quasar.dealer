@model Simplify.Quasar.Areas.ConfiguracaoApp.ViewModels.EquipamentoCadastroViewModel
@{
    ViewBag.Title = "Configuração";
    ViewBag.Description = "Novo Equipamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>@ViewBag.Title<small>@ViewBag.Description</small></h1>
</section>
<section class="content">
    <div class="box box-default">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="box-body">@Html.Partial("_Form", Model)</div>
            <div class="box-footer text-right">
                <button class="btn btn-success" type="submit"><i class="fa fa-check fa-fw"></i> Salvar</button>
                <a class="btn btn-danger" href="@Url.Action("Index")"><i class="fa fa-times fa-fw"></i> Cancelar</a>
            </div>
        }
    </div>
</section>
