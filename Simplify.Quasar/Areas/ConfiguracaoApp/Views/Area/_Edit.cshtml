@model Simplify.Quasar.Areas.ConfiguracaoApp.ViewModels.AreaViewModel

@{
    ViewBag.Title = "Edit";
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="modal-header bg-blue-gradient">
            <span><i class="fa-solid fa-pen-to-square fa-fw"></i>&nbsp;&nbsp;Modificar cadastro de área</span>
        </div>

        @Html.HiddenFor(m => m.Id)

<div class="modal-body">

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <label class="form-label">Nome</label>
                @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", @autocomplete = "off", @maxlength = "100" })
                @Html.ValidationMessageFor(x => x.Nome, null, new { @class = "text-red text-nowrap" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <label class="form-label">Descrição</label>
                @Html.TextAreaFor(m => m.Descricao, new { @class = "form-control", @autocomplete = "off", @rows = "3", @maxlength = "500" })
                @Html.ValidationMessageFor(x => x.Descricao, null, new { @class = "text-red text-nowrap" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <label class="text-nowrap">Tipo</label>
                @Html.DropDownListFor(m => m.TipoAreaId, Model.TipoAreaDDL, "-- Selecione --", new { @class = "form-control" })
                <div class="invalid-feedback">@Html.ValidationMessageFor(m => m.TipoAreaId)</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="checkbox">
                <label style="padding-left:0px !important;">@Html.CheckBoxFor(x => x.Etiqueta)<b>&nbsp;Conferir Item/Quantidade</b></label>
            </div>
        </div>
    </div>

</div>

    <div class="modal-footer">
        <div class="row">
            <div class="col-xs-12">
                <div class="pull-right">
                    <button type="submit" id="btnSave" class="btn btn-success"><i class="fa-solid fa-check fa-fw"></i> Salvar</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa-solid fa-xmark fa-fw"></i> Fechar</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12 text-left">
                <p class="card-text text-muted" style="margin-bottom:0px">
                    <small><i>Criado por <b>@Model.CriadoPorNome</b> em @Model.CriadoEm</i></small>
                    @Html.HiddenFor(m => m.CriadoPor)
                    @Html.HiddenFor(m => m.CriadoPorNome)
                    @Html.HiddenFor(m => m.CriadoEm)
                </p>
                @if (Model.ModificadoPor != null)
                {
                    <p class="card-text text-muted">
                        <small><i>Modificado por <b>@Model.ModificadoPorNome</b> em @Model.ModificadoEm</i></small>
                        @Html.HiddenFor(m => m.ModificadoPor)
                        @Html.HiddenFor(m => m.ModificadoPorNome)
                        @Html.HiddenFor(m => m.ModificadoEm)
                    </p>
                }
            </div>
        </div>
    </div>
    }
    }
    else
    {
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
    }

<script>
    $('.input-validation-error').parents('.form-group').addClass('has-error');

    $('.form-control').on('change', function () {
        $(this).parent().removeClass('has-error');
        $(this).next().html('');
    });

    $('#Etiqueta').iCheck({
        checkboxClass: 'icheckbox_flat-green'
    });

</script>

