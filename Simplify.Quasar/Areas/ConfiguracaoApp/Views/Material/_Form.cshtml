    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.MediaVendas)
            @Html.TextBoxFor(m => m.MediaVendas, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.MediaVendas, null, new { @class = "text-red" })
