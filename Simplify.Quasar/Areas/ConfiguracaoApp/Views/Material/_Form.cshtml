</div>

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            @Html.LabelFor(m => m.ItemCritico)
            <label class="critical-flag" for="ItemCritico">
                @Html.CheckBoxFor(m => m.ItemCritico, new { @class = "no-icheck" })
                <span>Crítico</span>
            </label>
        </div>
    </div>
    <div class="col-md-9">
        <div class="form-group">
            @Html.LabelFor(m => m.ObsItemCritico)
            <span id="critical-observation-required" class="text-red" style="display:none">Obrigatório</span>
            @Html.TextBoxFor(m => m.ObsItemCritico, new { @class = "form-control", maxlength = "100", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.ObsItemCritico, null, new { @class = "text-red" })
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', function () {
        $('#Zona1Id, #Zona2Id, #Zona3Id, #CategoriaProduto').select2({
            width: '100%',
            placeholder: 'Selecione',
            allowClear: true
        });

        function configurarEquipamento(zonaSelector, equipamentoSelector) {
            var zona = $(zonaSelector);
            var equipamento = $(equipamentoSelector);

            equipamento.select2({
                width: '100%',
                placeholder: 'Selecione',
                allowClear: true,
                language: {
                    noResults: function () { return 'Nenhum equipamento disponível'; }
                }
            });

            equipamento.prop('disabled', !zona.val());

            zona.on('change.material-equipment', function () {
                equipamento.empty().append(new Option('', '', true, true));
                equipamento.prop('disabled', true).trigger('change');

                if (!zona.val()) {
                    return;
                }

                $.getJSON(
                    '@Url.Action("GetEquipamentosPorZona", "Material", new { area = "ConfiguracaoApp" })',
                    { zonaId: zona.val(), _: new Date().getTime() })
                    .done(function (response) {
                        $.each(response.results || [], function (_, item) {
                            equipamento.append(new Option(item.text, item.id, false, false));
                        });
                    })
                    .always(function () {
                        equipamento.prop('disabled', false).trigger('change');
                    });
            });
        }

        configurarEquipamento('#Zona1Id', '#Eqpto1Id');
        configurarEquipamento('#Zona2Id', '#Eqpto2Id');
        configurarEquipamento('#Zona3Id', '#Eqpto3Id');

        function atualizarObservacaoItemCritico() {
            var itemCritico = $('#ItemCritico').is(':checked');
            var observacao = $('#ObsItemCritico');

            observacao.prop('disabled', !itemCritico).prop('required', itemCritico);
            $('#critical-observation-required').toggle(itemCritico);
            if (!itemCritico) {
                observacao.val('');
            }
        }

        $('#ItemCritico').on('change.material-critical', atualizarObservacaoItemCritico);
        atualizarObservacaoItemCritico();

        $('.input-validation-error').closest('.form-group').addClass('has-error');
    });
</script>
