@model Simplify.Quasar.Areas.ConfiguracaoApp.ViewModels.MaterialCadastroViewModel
@{
    bool isEdit = ViewBag.IsEdit == true;
}

<style>
    .critical-flag {
        display: flex;
        align-items: center;
        min-height: 40px;
        margin: 0;
        padding: 9px 12px;
        border: 1px solid rgba(23, 48, 66, 0.14);
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.08);
        cursor: pointer;
    }

    .critical-flag input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin: 0 9px 0 0;
        accent-color: #f59e0b;
    }

    .critical-flag span {
        color: var(--text-900);
        font-weight: 700;
        text-transform: uppercase;
    }
</style>

@Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            @Html.LabelFor(m => m.Codigo)
            @if (isEdit)
            {
                @Html.HiddenFor(m => m.Codigo)
                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", @readonly = "readonly" })
            }
            else
            {
                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", maxlength = "100", autocomplete = "off" })
            }
            @Html.ValidationMessageFor(m => m.Codigo, null, new { @class = "text-red" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            @Html.LabelFor(m => m.ItemApollo)
            @Html.TextBoxFor(m => m.ItemApollo, new { @class = "form-control", maxlength = "100", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.ItemApollo, null, new { @class = "text-red" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.Descricao)
            @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", maxlength = "500", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.Descricao, null, new { @class = "text-red" })
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.Comp)
            @Html.TextBoxFor(m => m.Comp, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.Comp, null, new { @class = "text-red" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.Larg)
            @Html.TextBoxFor(m => m.Larg, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.Larg, null, new { @class = "text-red" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.Altu)
            @Html.TextBoxFor(m => m.Altu, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.Altu, null, new { @class = "text-red" })
        </div>
    </div>
</div>

<hr />

