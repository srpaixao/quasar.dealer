@model IEnumerable<Simplify.Quasar.Areas.ControleAcessoApp.ViewModels.AtividadeViewModel>
@{
    ViewBag.Title = "Controle de Acesso";
    ViewBag.Description = "Atividades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .activity-refresh-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .activity-refresh-status {
        padding: 8px 12px;
        border-radius: 10px;
        background: rgba(39, 139, 179, 0.10);
        color: var(--text-700);
        font-size: 13px;
    }

    .activity-refresh-status .fa {
        margin-right: 5px;
        color: var(--brand-500);
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-header with-border">
            <h3 class="box-title">
                <i class="fa-solid fa-users-viewfinder"></i>
                Usuários online
            </h3>
            <div class="activity-refresh-toolbar pull-right">
                <span id="online-count" class="label label-success">@Model.Count() online</span>
                <div id="activity-refresh-status" class="activity-refresh-status" aria-live="polite">
                    <i class="fa fa-refresh"></i>
                    <span id="activity-last-refresh">Aguardando primeira atualização</span>
                    <span> &middot; </span>
                    <span id="activity-next-refresh">Próxima em 01:00</span>
                </div>
            </div>
        </div>
        <div class="box-body">
            <div class="table-responsive">
                <table class="table table-condensed table-bordered table-hover" id="tbAtividades">
                    <thead>
                        <tr>
                            <th>Login</th>
                            <th>Nome</th>
                            <th>Filial</th>
                            <th>Funcionalidade</th>
                            <th>Última atividade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="label label-success">Online</span>
                                    <strong style="margin-left:5px">@item.Login</strong>
                                </td>
                                <td>@item.Nome</td>
                                <td>@item.Filial</td>
                                <td title="@item.Rota">@item.Funcionalidade</td>
                                <td data-order="@item.UltimaAtividade.ToString("yyyyMMddHHmmss")">
                                    @item.UltimaAtividade.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>
    <script type="text/javascript">
        var activityTable = null;
        var activityRefreshTimer = null;
        var activityCountdownTimer = null;
        var activityNextRefreshAt = null;

        function escapeActivityText(value) {
            return $('<div>').text(value || '').html();
        }

        function formatActivityRefreshTime(date) {
            return String(date.getHours()).padStart(2, '0') + ':' +
                String(date.getMinutes()).padStart(2, '0') + ':' +
                String(date.getSeconds()).padStart(2, '0');
        }

        function updateActivityCountdown() {
            if (!activityNextRefreshAt) {
                return;
            }

            var seconds = Math.max(0, Math.ceil((activityNextRefreshAt - Date.now()) / 1000));
            var minutes = Math.floor(seconds / 60);
            var remainingSeconds = seconds % 60;
            $('#activity-next-refresh').text(
                'Próxima em ' + String(minutes).padStart(2, '0') + ':' + String(remainingSeconds).padStart(2, '0')
            );
        }

        function registerActivityRefreshSuccess(response) {
            $('#activity-refresh-status').removeClass('text-danger');
            $('#activity-last-refresh').text('Última atualização: ' + formatActivityRefreshTime(new Date()));
            $('#online-count').text((response.onlineCount || 0) + ' online');
        }

        function registerActivityRefreshError() {
            $('#activity-refresh-status').addClass('text-danger');
            $('#activity-last-refresh').text('Falha na atualização automática');
        }

        function refreshActivities() {
            activityNextRefreshAt = Date.now() + 60000;
            updateActivityCountdown();

            if (document.hidden || !activityTable) {
                return;
            }

            activityTable.ajax.reload(null, false);
        }

        $(function () {
            activityTable = $('#tbAtividades').DataTable({
                ajax: {
                    url: '@Url.Action("Index", "Atividade", new { area = "ControleAcessoApp", atualizar = true })',
                    type: 'GET',
                    dataSrc: function (response) {
                        registerActivityRefreshSuccess(response);
                        return response.data || [];
                    },
                    error: registerActivityRefreshError
                },
                columns: [
                    {
                        data: 'Login',
                        render: function (data) {
                            return '<span class="label label-success">Online</span>' +
                                '<strong style="margin-left:5px">' + escapeActivityText(data) + '</strong>';
                        }
                    },
                    { data: 'Nome', render: escapeActivityText },
                    { data: 'Filial', render: escapeActivityText },
                    {
                        data: 'Funcionalidade',
                        render: function (data, type, row) {
                            return '<span title="' + escapeActivityText(row.Rota) + '">' + escapeActivityText(data) + '</span>';
                        }
                    },
                    {
                        data: 'UltimaAtividade',
                        render: function (data, type, row) {
                            return type === 'sort' || type === 'type' ? row.UltimaAtividadeOrdem : escapeActivityText(data);
                        }
                    }
                ],
                pageLength: 25,
                order: [[4, 'desc']],
                language: {
                    search: 'Procurar:',
                    lengthMenu: 'Exibir _MENU_ registros por página',
                    zeroRecords: 'Nenhum usuário online',
                    info: 'Exibindo de _START_ a _END_ de um total de _TOTAL_ registros',
                    infoEmpty: 'Nenhum usuário online',
                    infoFiltered: '',
                    paginate: {
                        next: 'Próxima',
                        previous: 'Anterior'
                    }
                }
            });

            activityNextRefreshAt = Date.now() + 60000;
            updateActivityCountdown();
            activityRefreshTimer = window.setInterval(refreshActivities, 60000);
            activityCountdownTimer = window.setInterval(updateActivityCountdown, 1000);

            $(window).on('beforeunload', function () {
                window.clearInterval(activityRefreshTimer);
                window.clearInterval(activityCountdownTimer);
            });
        });
    </script>
}
