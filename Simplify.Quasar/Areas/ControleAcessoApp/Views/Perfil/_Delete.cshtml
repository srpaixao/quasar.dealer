@model Simplify.Quasar.Areas.ControleAcessoApp.ViewModels.PerfilViewModel
@{
    ViewBag.Title = "Delete Perfil";
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        <div class="modal-header bg-blue-gradient">
            <span><i class="fa-solid fa-user-xmark fa-lg fa-fw"></i>&nbsp;&nbsp;Excluir Perfil de Acesso</span>
        </div>

        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="modal-body">
            <p class="confirm">Confirma a exclusão do perfil <b>@Model.Nome</b> ?</p>
            @if (Model.Descricao != null && Model.Descricao != string.Empty)
            {
                <p class="text-muted">Descrição: @Model.Descricao</p>
            }
        </div>

        <div class="modal-footer border-0">
            <button type="submit" id="btnSave" class="btn btn-success"><i class="fa-solid fa-check fa-fw"></i> Sim</button>
            <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa-solid fa-xmark fa-fw"></i> Não</button>
        </div>
    }
}
else
{
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
}

<script>
    $(document).ready(function () {
    });
</script>
