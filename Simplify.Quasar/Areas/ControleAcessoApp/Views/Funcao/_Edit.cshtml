@model Simplify.Quasar.Areas.ControleAcessoApp.ViewModels.FuncaoViewModel
@{
    ViewBag.Title = "Edit Funcao";
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        <div class="modal-header bg-blue-gradient">
            <span><i class="fa-solid fa-key fa-lg fa-fw"></i>&nbsp;&nbsp;Modificar Função</span>
        </div>

        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="modal-body">
            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label class="form-label">Código</label>
                        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control upper", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.Codigo)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="form-label">Descrição (PT-BR)</label>
                        @Html.TextBoxFor(m => m.DescPTBR, new { @class = "form-control", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.DescPTBR)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-8">
                    <div class="form-group">
                        <label class="form-label">Descrição (ES)</label>
                        @Html.TextBoxFor(m => m.DescES, new { @class = "form-control", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.DescES)</div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-4">
                    <div class="form-group">
                        <label class="form-label">Componente</label>
                        @Html.TextBoxFor(m => m.CodComponente, new { @class = "form-control upper", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.CodComponente)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label class="form-label">Menu</label>
                        @Html.DropDownListFor(m => m.IdMenu, Model.MenuDDL, "-- Selecione --", new { @class = "form-control" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.IdMenu)</div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label class="form-label">Filial</label>
                        @Html.DropDownListFor(m => m.FilialId, Model.FilialDDL, "-- Selecione --", new { @class = "form-control" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.FilialId)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label class="form-label">Controller</label>
                        @Html.TextBoxFor(m => m.Controller, new { @class = "form-control", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.Controller)</div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label class="form-label">Action</label>
                        @Html.TextBoxFor(m => m.Action, new { @class = "form-control", @autocomplete = "off" })
                        <div class="invalid-feedback text-nowrap">@Html.ValidationMessageFor(m => m.Action)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <div class="checkbox">
                            <label>
                                @Html.CheckBoxFor(m => m.Status) Ativo
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <div class="pull-right">
                <button type="submit" id="btnSave" class="btn btn-success"><i class="fa-solid fa-check fa-fw"></i> Salvar</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa-solid fa-xmark fa-fw"></i> Fechar</button>
            </div>
        </div>
    }
}
else
{
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
}

<script>
    $(document).ready(function () {
        $('.input-validation-error').each(function () {
            $(this).addClass('is-invalid')
        }).on('focus', function () {
            $(this).removeClass('is-invalid')
        })
    });
</script>
