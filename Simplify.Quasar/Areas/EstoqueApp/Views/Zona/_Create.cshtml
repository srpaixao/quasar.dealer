@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.ZonaViewModel
@{
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="modal-header bg-blue-gradient">
            <span><i class="fa fa-plus-square fa-fw"></i>&nbsp;&nbsp;Cadastrar Zona</span>
        </div>

        <div class="modal-body">
            <div class="row">
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label>Nome</label>
                        @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", @autocomplete = "off", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Nome, null, new { @class = "text-red" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6">
                    <div class="form-group">
                        <label>&Aacute;rea</label>
                        @Html.DropDownListFor(m => m.AreaId, Model.AreaDDL, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label>Descri&ccedil;&atilde;o</label>
                        @Html.TextAreaFor(m => m.Descricao, new { @class = "form-control", rows = "3", maxlength = "500" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-6 col-lg-3">
                    <div class="form-group">
                        <label>Linhas</label>
                        @Html.TextBoxFor(m => m.QtdeLinha, new { @class = "form-control text-center", type = "number", min = "0" })
                    </div>
                </div>
                <div class="col-xs-6 col-lg-3">
                    <div class="form-group">
                        <label>R$</label>
                        @Html.TextBoxFor(m => m.ValorPedido, new { @class = "form-control text-right", type = "number", step = "0.01", min = "0" })
                    </div>
                </div>
                <div class="col-xs-6 col-lg-3">
                    <div class="form-group">
                        <label>Clientes</label>
                        @Html.TextBoxFor(m => m.QtdeCliente, new { @class = "form-control text-center", type = "number", min = "0" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-6">
                    <div class="checkbox">
                        <label style="padding-left:0px !important;">@Html.CheckBoxFor(m => m.ProntoDespacho, new { @class = "js-zona-flag" })<b>&nbsp;Pronto para despacho</b></label>
                    </div>
                </div>
                <div class="col-xs-6">
                    <div class="checkbox">
                        <label style="padding-left:0px !important;">@Html.CheckBoxFor(m => m.Ativo, new { @class = "js-zona-flag" })<b>&nbsp;Ativo</b></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-success"><i class="fa fa-check fa-fw"></i> Salvar</button>
            <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa fa-times fa-fw"></i> Fechar</button>
        </div>
    }
}
else
{
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
}
