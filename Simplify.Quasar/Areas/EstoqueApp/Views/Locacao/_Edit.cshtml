@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.LocacaoViewModel
@{
    ViewBag.Title = "Edit";
    Layout = null;
}

@if (ViewBag.Exception == null)
{
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="modal-header bg-blue-gradient">
            <span><i class="fa-solid fa-pen-to-square fa-lg fa-fw"></i>&nbsp;&nbsp;Modificar cadastro de locação</span>
        </div>

        <div class="modal-body">

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Código</label>
                        <p class="input-view text-center">@Model.Codigo</p>
                        @Html.HiddenFor(x => x.Codigo)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="form-label">Descrição</label>
                        @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", @autocomplete = "off" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Tipo</label>
                        @Html.DropDownListFor(m => m.Tipo, Model.TipoDDL, "-- Selecione --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Tipo, null, new { @class = "text-red" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Área</label>
                        @Html.TextBoxFor(m => m.AreaId, new { @class = "form-control text-center", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Zona</label>
                        @Html.DropDownListFor(m => m.ZonaId, Model.ZonaDDL, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Curva</label>
                        @Html.TextBoxFor(m => m.Curva, new { @class = "form-control text-center", @autocomplete = "off" })
                    </div>
                </div>
                <div class="col-xs-12 col-lg-3">
                    <div class="form-group">
                        <label class="form-label" style="visibility:hidden">x</label>
                        <div class="checkbox">
                            <label style="padding-left:0px !important">@Html.CheckBoxFor(x => x.Bloqueado)<b>&nbsp;&nbsp;&nbsp;Bloqueado</b></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="form-label">Observações</label>
                        @Html.TextAreaFor(m => m.Observacoes, new { @class = "form-control", @rows = "3", @autocomplete = "off" })
                    </div>
                </div>
            </div>
        </div>


        <div class="modal-footer">
            <div class="row">
                <div class="col-xs-12">
                    <div class="pull-right">
                        <button type="submit" id="btnSave" class="btn btn-success"><i class="fa-solid fa-check fa-fw"></i> Salvar</button>
                        <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa-solid fa-xmark fa-fw"></i> Fechar</button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 text-left">
                    <p class="card-text text-muted" style="margin-bottom:0px">
                        <small><i>Criado por <b>@Model.CriadoPorNome</b> em @Model.CriadoEm</i></small>
                        @Html.HiddenFor(m => m.CriadoPor)
                        @Html.HiddenFor(m => m.CriadoPorNome)
                        @Html.HiddenFor(m => m.CriadoEm)
                    </p>
                    @if (Model.ModificadoPor != null)
                    {
                        <p class="card-text text-muted">
                            <small><i>Modificado por <b>@Model.ModificadoPorNome</b> em @Model.ModificadoEm</i></small>
                            @Html.HiddenFor(m => m.ModificadoPor)
                            @Html.HiddenFor(m => m.ModificadoPorNome)
                            @Html.HiddenFor(m => m.ModificadoEm)
                        </p>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    @Html.Partial("~/Views/Shared/ErrorModal.cshtml")
}

<script>
    $('.input-validation-error').parents('.form-group').addClass('has-error');

    $('.form-control').on('change', function () {
        $(this).parent().removeClass('has-error');
        $(this).next().html('');
    });

    $('#Bloqueado').iCheck({
        checkboxClass: 'icheckbox_flat-red'
    });

</script>

