@using System
@using System.Linq
@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.LocacaoEtiquetaImpressaoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Etiquetas de locações — modelo alternativo</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef1f4; color: #231f20; font-family: Arial, Helvetica, sans-serif; }
        .print-toolbar { position: sticky; top: 0; z-index: 10; padding: 12px 20px; background: #0f172a; color: #fff; display: flex; align-items: center; gap: 12px; }
        .print-toolbar button { border: 0; border-radius: 5px; padding: 10px 18px; background: #198754; color: #fff; font-weight: 700; cursor: pointer; }
        .print-toolbar button:disabled { cursor: wait; opacity: .65; }
        .print-toolbar a { color: #fff; }
        .labels { padding: 20px; }
        .label-page { width: 100mm; height: 50mm; margin: 0 auto 18px; padding: 1.5mm; background: #fff; border: .25mm solid #231f20; display: flex; align-items: stretch; gap: 1.5mm; overflow: hidden; page-break-after: always; break-after: page; }
        .label-page:last-child { page-break-after: auto; break-after: auto; }
        .label-qr { flex: 0 0 44mm; width: 44mm; height: 44mm; align-self: center; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .label-qr canvas, .label-qr img { display: block; width: 44mm !important; height: 44mm !important; }
        .label-code { flex: 1 1 auto; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: stretch; overflow: hidden; }
        .label-code-line { flex: 1 1 0; min-height: 0; width: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; white-space: nowrap; }
        .label-code-text { display: inline-block; font-family: Arial Black, Arial, Helvetica, sans-serif; font-size: 38pt; font-weight: 900; line-height: .9; letter-spacing: -.3mm; transform-origin: center center; white-space: nowrap; }
        @@page { size: 100mm 50mm; margin: 0; }
        @@media print {
            body { background: #fff; }
            .print-toolbar { display: none !important; }
            .labels { padding: 0; }
            .label-page { margin: 0; border: 0; }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button id="btn-imprimir" type="button" disabled>Preparando QR Codes...</button>
        <span>@Model.Etiquetas.Count.ToString("N0") etiqueta(s)</span>
        <a href="@Url.Action("LayoutEtiquetas", "Locacao", new { area = "EstoqueApp", token = Request.QueryString["token"] })">Ver modelo padrão</a>
        <a href="javascript:window.close()">Fechar</a>
    </div>
    <main class="labels">
        @for (int indice = 0; indice < Model.Etiquetas.Count; indice++)
        {
            var etiqueta = Model.Etiquetas[indice];
            string[] partes = (etiqueta.CodigoFormatado ?? string.Empty)
                .Split(new[] { '.' }, StringSplitOptions.RemoveEmptyEntries);
            string[] linhas;
            if (partes.Length >= 5)
            {
                linhas = new[]
                {
                    partes[0],
                    string.Join(".", partes.Skip(1).Take(2)),
                    string.Join(".", partes.Skip(3))
                };
            }
            else if (partes.Length >= 3)
            {
                linhas = new[] { partes[0], partes[1], string.Join(".", partes.Skip(2)) };
            }
            else
            {
                linhas = partes.Length == 2
                    ? new[] { partes[0], partes[1] }
                    : new[] { etiqueta.CodigoFormatado ?? string.Empty };
            }

            <section class="label-page">
                <div class="label-qr" data-value="@etiqueta.CodigoSemEspacos"></div>
                <div class="label-code">
                    @foreach (string linha in linhas)
                    {
                        <div class="label-code-line"><span class="label-code-text">@linha</span></div>
                    }
                </div>
            </section>
        }
    </main>
    <script src="@Url.Content("~/Scripts/qrcode.min.js")"></script>
    <script>
        (function () {
            var botao = document.getElementById('btn-imprimir');
            var elementos = document.querySelectorAll('.label-qr');
            try {
                for (var i = 0; i < elementos.length; i++) {
                    new QRCode(elementos[i], {
                        text: elementos[i].getAttribute('data-value') || '',
                        width: 320,
                        height: 320,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }

                function ajustarCodigos() {
                    var linhas = document.querySelectorAll('.label-code-line');
                    for (var j = 0; j < linhas.length; j++) {
                        var texto = linhas[j].querySelector('.label-code-text');
                        texto.style.transform = 'none';
                        var larguraDisponivel = linhas[j].clientWidth * 0.94;
                        var larguraTexto = texto.offsetWidth;
                        var escalaHorizontal = larguraTexto > 0 ? larguraDisponivel / larguraTexto : 1;
                        escalaHorizontal = Math.min(1.65, escalaHorizontal);
                        texto.style.transform = 'scaleX(' + escalaHorizontal.toFixed(3) + ')';
                    }
                    botao.disabled = false;
                    botao.textContent = 'Imprimir ou salvar como PDF';
                    botao.onclick = function () { window.print(); };
                }

                if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(ajustarCodigos);
                } else {
                    ajustarCodigos();
                }
            } catch (e) {
                botao.textContent = 'Não foi possível gerar os QR Codes';
            }
        })();
    </script>
</body>
</html>
