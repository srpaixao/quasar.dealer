@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.LocacaoEtiquetaLoteViewModel
@{
    ViewBag.Title = "Cadastro";
    ViewBag.Description = "Locações";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DataTables/dataTables.bootstrap.min.css" rel="stylesheet" />

<style>
    .etiqueta-filter-box { background: #f8fafc; border: 1px solid #d9e1e8; border-radius: 4px; margin-bottom: 15px; padding: 15px 15px 5px; }
    .etiqueta-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 15px 0; align-items: center; }
    .etiqueta-selected-count { color: #52606d; font-weight: 600; margin-left: 4px; }
    #tbLocacaoEtiqueta th, #tbLocacaoEtiqueta td { text-align: center; vertical-align: middle; }
    #tbLocacaoEtiqueta th:nth-child(3), #tbLocacaoEtiqueta td:nth-child(3) { text-align: left; }
</style>

<section class="content-header">
    <h1>@ViewBag.Title <small>@ViewBag.Description</small></h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">
            @Html.Partial("_Tabs")
            @Html.AntiForgeryToken()

            <div class="etiqueta-filter-box">
                <div class="row">
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-codigo">Código</label>
                        <input type="text" id="filtro-codigo" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-descricao">Descrição</label>
                        <input type="text" id="filtro-descricao" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-area">Área</label>
                        @Html.DropDownList("filtro-area", Model.Areas, new { @class = "form-control", id = "filtro-area" })
                    </div>
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-zona">Zona</label>
                        @Html.DropDownList("filtro-zona", Model.Zonas, new { @class = "form-control", id = "filtro-zona" })
                    </div>
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-equipamento">Equipamento</label>
                        @Html.DropDownList("filtro-equipamento", Model.Equipamentos, new { @class = "form-control", id = "filtro-equipamento" })
                    </div>
                    <div class="col-sm-6 col-md-3 form-group">
                        <label for="filtro-demanda">Demanda</label>
                        @Html.DropDownList("filtro-demanda", Model.Demandas, new { @class = "form-control", id = "filtro-demanda" })
                    </div>
                    <div class="col-sm-12 col-md-6 form-group" style="padding-top:25px">
                        <button type="button" id="btn-filtrar" class="btn btn-primary"><i class="fa fa-search fa-fw"></i> Filtrar</button>
                        <button type="button" id="btn-limpar" class="btn btn-default"><i class="fa fa-eraser fa-fw"></i> Limpar filtros</button>
                    </div>
                </div>
            </div>

            <div class="etiqueta-actions">
                <button type="button" id="btn-marcar-todos" class="btn btn-default">
                    <i class="fa fa-check-square-o fa-fw"></i> MARCAR TODOS
                </button>
                <button type="button" id="btn-desmarcar-todos" class="btn btn-default">
                    <i class="fa fa-square-o fa-fw"></i> DESMARCAR TODOS
                </button>
                <button type="button" id="btn-imprimir-selecionados" class="btn btn-success">
                    <i class="fa fa-print fa-fw"></i> IMPRIMIR SELECIONADOS
                </button>
                <span id="quantidade-selecionada" class="etiqueta-selected-count">0 selecionada(s)</span>
            </div>

            <p id="processing">Carregando dados...</p>
            <div class="data-container hide">
                <div class="table-responsive">
                    <table class="table table-condensed table-bordered table-hover table-small" id="tbLocacaoEtiqueta">
                        <thead>
                            <tr>
                                <th>Imprimir</th>
                                <th>Código</th>
                                <th>Descrição</th>
                                <th>Área</th>
                                <th>Zona</th>
                                <th>Equipamento</th>
                                <th>Demanda</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            var selecionadas = {};
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();

            function textoSeguro(valor) {
                return $('<div/>').text(valor || '').html();
            }

            var table;

            function filtros() {
                return {
                    codigo: $('#filtro-codigo').val() || '',
                    descricao: $('#filtro-descricao').val() || '',
                    areaId: $('#filtro-area').val() || null,
                    zonaId: $('#filtro-zona').val() || null,
                    equipamentoId: $('#filtro-equipamento').val() || null,
                    demanda: $('#filtro-demanda').val() || '',
                    pesquisa: table ? table.search() : ''
                };
            }

            function idsSelecionados() {
                return Object.keys(selecionadas).filter(function (id) {
                    return selecionadas[id] === true;
                }).map(function (id) { return parseInt(id, 10); });
            }

            function atualizarQuantidade() {
                $('#quantidade-selecionada').text(idsSelecionados().length + ' selecionada(s)');
            }

            function limparSelecao() {
                selecionadas = {};
                $('#tbLocacaoEtiqueta .locacao-imprimir').prop('checked', false);
                atualizarQuantidade();
            }

            function avisar(mensagem) {
                swal({
                    title: 'Impressão de Etiquetas — Locações',
                    text: mensagem,
                    icon: 'warning',
                    button: { text: 'OK', className: 'swal-btn-info' }
                });
            }

            table = $('#tbLocacaoEtiqueta').DataTable({
                deferRender: true,
                serverSide: true,
                processing: true,
                searching: true,
                autoWidth: false,
                pageLength: 25,
                order: [[1, 'asc']],
                ajax: {
                    url: '@Url.Action("GetEtiquetasData", "Locacao", new { area = "EstoqueApp" })',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: function (d) {
                        $.extend(d, filtros());
                        return JSON.stringify(d);
                    }
                },
                columns: [
                    {
                        data: 'Id', orderable: false, searchable: false,
                        render: function (data, type) {
                            return type === 'display'
                                ? '<input type="checkbox" class="locacao-imprimir" data-id="' + data + '" />'
                                : data;
                        }
                    },
                    { data: 'Codigo', render: function (data) { return textoSeguro(data); } },
                    { data: 'Descricao', render: function (data) { return textoSeguro(data); } },
                    { data: 'Area', render: function (data) { return textoSeguro(data); } },
                    { data: 'Zona', render: function (data) { return textoSeguro(data); } },
                    { data: 'Equipamento', render: function (data) { return textoSeguro(data); } },
                    { data: 'Demanda', render: function (data) { return textoSeguro(data); } }
                ],
                rowCallback: function (row, data) {
                    $(row).find('.locacao-imprimir').prop('checked', selecionadas[data.Id] === true);
                },
                drawCallback: function () { atualizarQuantidade(); },
                initComplete: function () {
                    $('#processing').addClass('hide');
                    $('.data-container').removeClass('hide');
                },
                language: {
                    processing: 'Carregando dados...',
                    lengthMenu: 'Exibir _MENU_ itens por página',
                    zeroRecords: 'Nenhuma locação encontrada',
                    info: 'Exibindo _START_ de _END_ de um total de _TOTAL_ itens',
                    infoEmpty: 'Exibindo 0 de 0 itens',
                    infoFiltered: '',
                    thousands: '.', decimal: ',',
                    paginate: { first: 'Primeira', last: 'Última', next: 'Próxima', previous: 'Anterior' }
                }
            });

            $('#tbLocacaoEtiqueta').on('change', '.locacao-imprimir', function () {
                selecionadas[$(this).data('id')] = this.checked;
                atualizarQuantidade();
            });

            $('#btn-filtrar').on('click', function () {
                limparSelecao();
                table.ajax.reload(null, true);
            });
            $('#filtro-codigo, #filtro-descricao').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    limparSelecao();
                    table.ajax.reload(null, true);
                }
            });
            $('#btn-limpar').on('click', function () {
                limparSelecao();
                $('#filtro-codigo, #filtro-descricao').val('');
                $('#filtro-area, #filtro-zona, #filtro-equipamento, #filtro-demanda').val('');
                table.search('');
                table.ajax.reload(null, true);
            });

            var pesquisaAtual = table.search();
            table.on('search.dt', function () {
                var novaPesquisa = table.search();
                if (novaPesquisa !== pesquisaAtual) {
                    pesquisaAtual = novaPesquisa;
                    limparSelecao();
                }
            });

            function alterarTodosFiltrados(marcar) {
                var dados = filtros();
                dados.__RequestVerificationToken = antiForgeryToken;
                $('#btn-marcar-todos, #btn-desmarcar-todos').prop('disabled', true);
                $.ajax({
                    url: '@Url.Action("ObterIdsEtiquetas", "Locacao", new { area = "EstoqueApp" })',
                    type: 'POST',
                    data: dados
                }).done(function (result) {
                    $.each(result.ids || [], function (_, id) {
                        if (marcar) selecionadas[id] = true;
                        else delete selecionadas[id];
                    });
                    table.rows({ page: 'current' }).every(function () {
                        $(this.node()).find('.locacao-imprimir').prop('checked', selecionadas[this.data().Id] === true);
                    });
                    atualizarQuantidade();
                }).fail(function () {
                    avisar('Não foi possível atualizar a seleção das locações.');
                }).always(function () {
                    $('#btn-marcar-todos, #btn-desmarcar-todos').prop('disabled', false);
                });
            }

            $('#btn-marcar-todos').on('click', function () { alterarTodosFiltrados(true); });
            $('#btn-desmarcar-todos').on('click', function () { alterarTodosFiltrados(false); });

            $('#btn-imprimir-selecionados').on('click', function () {
                var ids = idsSelecionados();
                if (ids.length === 0) {
                    avisar('Selecione pelo menos uma locação para imprimir.');
                    return;
                }

                var janela = window.open('about:blank', '_blank');
                $.ajax({
                    url: '@Url.Action("PrepararEtiquetas", "Locacao", new { area = "EstoqueApp" })',
                    type: 'POST',
                    data: { ids: ids.join(','), __RequestVerificationToken: antiForgeryToken }
                }).done(function (result) {
                    if (!result.success) {
                        if (janela) janela.close();
                        avisar(result.message || 'Não foi possível preparar as etiquetas.');
                        return;
                    }
                    if (janela) janela.location = result.url;
                    else window.open(result.url, '_blank');
                }).fail(function () {
                    if (janela) janela.close();
                    avisar('Não foi possível preparar as etiquetas.');
                });
            });
        });
    </script>
}
