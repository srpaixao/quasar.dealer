@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.LocacaoEtiquetaImpressaoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Etiquetas de locações</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef1f4; color: #231f20; font-family: Arial, Helvetica, sans-serif; }
        .print-toolbar { position: sticky; top: 0; z-index: 10; padding: 12px 20px; background: #0f172a; color: #fff; display: flex; align-items: center; gap: 12px; }
        .print-toolbar button { border: 0; border-radius: 5px; padding: 10px 18px; background: #198754; color: #fff; font-weight: 700; cursor: pointer; }
        .print-toolbar button:disabled { cursor: wait; opacity: .65; }
        .print-toolbar a { color: #fff; }
        .labels { padding: 20px; }
        .label-page { width: 100mm; height: 50mm; margin: 0 auto 18px; padding: 2mm 3mm; background: #fff; border: .25mm solid #231f20; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5mm; overflow: hidden; page-break-after: always; break-after: page; page-break-inside: avoid; break-inside: avoid; }
        .label-page:last-child { page-break-after: auto; break-after: auto; }
        .label-qr { flex: 0 0 30mm; width: 30mm; height: 30mm; display: flex; align-items: center; justify-content: center; }
        .label-qr canvas, .label-qr img { display: block; width: 30mm !important; height: 30mm !important; }
        .label-code { flex: 0 0 11.5mm; width: 94mm; display: flex; align-items: center; justify-content: center; overflow: hidden; text-align: center; white-space: nowrap; }
        .label-code-text { display: inline-block; font-family: Arial Black, Arial, Helvetica, sans-serif; font-size: 34pt; font-weight: 900; line-height: .9; letter-spacing: -.3mm; white-space: nowrap; }
        @@page { size: 100mm 50mm; margin: 0; }
        @@media print {
            html, body { width: 100mm; margin: 0 !important; padding: 0 !important; background: #fff; }
            .print-toolbar { display: none !important; }
            .labels { width: 100mm; margin: 0 !important; padding: 0 !important; }
            .label-page { width: 100mm !important; height: 50mm !important; margin: 0 !important; padding: 2mm 3mm !important; border: 0; }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button id="btn-imprimir" type="button" disabled>Preparando QR Codes...</button>
        <span>@Model.Etiquetas.Count.ToString("N0") etiqueta(s)</span>
        <a href="javascript:window.close()">Fechar</a>
    </div>
    <main class="labels">
        @for (int indice = 0; indice < Model.Etiquetas.Count; indice++)
        {
            var etiqueta = Model.Etiquetas[indice];
            <section class="label-page">
                <div class="label-qr" data-value="@etiqueta.CodigoSemEspacos"></div>
                <div class="label-code"><span class="label-code-text">@etiqueta.CodigoFormatado</span></div>
            </section>
        }
    </main>
    <script src="@Url.Content("~/Scripts/qrcode.min.js")"></script>
    <script>
        (function () {
            var botao = document.getElementById('btn-imprimir');
            var elementos = document.querySelectorAll('.label-qr');
            try {
                for (var i = 0; i < elementos.length; i++) {
                    new QRCode(elementos[i], {
                        text: elementos[i].getAttribute('data-value') || '',
                        width: 256,
                        height: 256,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }
                function ajustarCodigos() {
                    var codigos = document.querySelectorAll('.label-code');
                    var tamanhosPorQuantidade = { 9: 40, 10: 38, 11: 36, 12: 34 };
                    for (var j = 0; j < codigos.length; j++) {
                        var texto = codigos[j].querySelector('.label-code-text');
                        var quantidade = (texto.textContent || '').trim().length;
                        var tamanhoConfigurado = tamanhosPorQuantidade[quantidade] || 34;
                        texto.style.fontSize = tamanhoConfigurado + 'pt';

                        var larguraDisponivel = codigos[j].clientWidth * 0.96;
                        var proporcao = texto.scrollWidth > 0 ? larguraDisponivel / texto.scrollWidth : 1;
                        var tamanho = Math.min(tamanhoConfigurado, tamanhoConfigurado * proporcao);
                        texto.style.fontSize = tamanho.toFixed(1) + 'pt';
                    }
                    botao.disabled = false;
                    botao.textContent = 'Imprimir ou salvar como PDF';
                    botao.onclick = function () { window.print(); };
                }

                if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(ajustarCodigos);
                } else {
                    ajustarCodigos();
                }
            } catch (e) {
                botao.textContent = 'Não foi possível gerar os QR Codes';
            }
        })();
    </script>
</body>
</html>
