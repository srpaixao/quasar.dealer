@model Simplify.Quasar.Areas.EstoqueApp.ViewModels.LocacaoEtiquetaImpressaoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Etiquetas de locações</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body { background: #eef1f4; color: #000; font-family: Arial, Helvetica, sans-serif; }
        .print-toolbar { position: sticky; top: 0; z-index: 10; padding: 12px 20px; background: #0f172a; color: #fff; display: flex; align-items: center; gap: 12px; }
        .print-toolbar button { border: 0; border-radius: 5px; padding: 10px 18px; background: #198754; color: #fff; font-weight: 700; cursor: pointer; }
        .print-toolbar .direct-print { background: #1473e6; }
        .print-toolbar select { min-width: 170px; height: 36px; border: 1px solid #94a3b8; border-radius: 5px; padding: 0 9px; background: #fff; color: #0f172a; font-weight: 600; }
        .print-toolbar button:disabled { cursor: wait; opacity: .65; }
        .print-toolbar a { color: #fff; }
        .labels { padding: 20px; }
        .label-page { position: relative; width: 100mm; height: 50mm; margin: 0 auto 18px; padding: 0; background: #fff; border: .25mm solid #231f20; overflow: hidden; page-break-after: always; break-after: page; page-break-inside: avoid; break-inside: avoid; }
        .label-page:last-child { page-break-after: auto; break-after: auto; }
        .label-qr { position: absolute; top: 1mm; left: 50%; width: 32mm; height: 32mm; transform: translateX(-50%); overflow: hidden; }
        .label-qr canvas, .label-qr img { display: block; width: 32mm !important; height: 32mm !important; }
        .label-code { position: absolute; right: 1.5mm; bottom: .5mm; left: 1.5mm; height: 15.5mm; display: flex; align-items: center; justify-content: center; overflow: hidden; text-align: center; white-space: nowrap; }
        .label-code-text { display: inline-block; font-family: Arial Black, Arial, Helvetica, sans-serif; font-size: 44pt; font-weight: 900; line-height: .84; letter-spacing: -.3mm; white-space: nowrap; }
        @@page { margin: 0; }
        @@media print {
            html, body { width: 100% !important; height: auto !important; margin: 0 !important; padding: 0 !important; background: #fff; }
            .print-toolbar { display: none !important; }
            .labels { width: 100% !important; margin: 0 !important; padding: 0 !important; }
            .label-page { width: 100mm !important; height: 50mm !important; margin: 0 auto !important; padding: 0 !important; border: 0; }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button id="btn-imprimir" type="button" disabled>Preparando QR Codes...</button>
        @if (Model.PodeImprimirDireto)
        {
            <label for="printer-select">Impressora:</label>
            <select id="printer-select">
                @foreach (var impressora in Model.Impressoras)
                {
                    if (impressora.Id == Model.ImpressoraSelecionadaId)
                    {
                        <option value="@impressora.Id" data-name="@impressora.Nome" data-ip="@impressora.IP" data-port="@impressora.Porta" selected>@impressora.Nome</option>
                    }
                    else
                    {
                        <option value="@impressora.Id" data-name="@impressora.Nome" data-ip="@impressora.IP" data-port="@impressora.Porta">@impressora.Nome</option>
                    }
                }
            </select>
            <button id="btn-imprimir-direto" class="direct-print" type="button">Imprimir direto</button>
        }
        <span>@Model.Etiquetas.Count.ToString("N0") etiqueta(s)</span>
        <span id="status-impressao-direta"></span>
        <a href="javascript:window.close()">Fechar</a>
    </div>
    @if (Model.PodeImprimirDireto)
    {
        <input type="hidden" id="ps-ip" value="@Model.PrinterServerIP" />
        <input type="hidden" id="ps-port" value="@Model.PrinterServerPort" />
        <textarea id="zpl-etiquetas" style="display:none">@Model.Zpl</textarea>
        <iframe src="" id="direct-label-print-frame" title="Servidor de impressão" style="display:none; width:0; height:0; border:0;"></iframe>
    }
    <main class="labels">
        @for (int indice = 0; indice < Model.Etiquetas.Count; indice++)
        {
            var etiqueta = Model.Etiquetas[indice];
            <section class="label-page">
                <div class="label-qr" data-value="@etiqueta.CodigoSemEspacos"></div>
                <div class="label-code" data-character-count="@((etiqueta.CodigoSemEspacos ?? string.Empty).Length)"><span class="label-code-text">@etiqueta.CodigoFormatado</span></div>
            </section>
        }
    </main>
    <script src="@Url.Content("~/Scripts/qrcode.min.js")"></script>
    <script>
        (function () {
            var botao = document.getElementById('btn-imprimir');
            var elementos = document.querySelectorAll('.label-qr');
            try {
                for (var i = 0; i < elementos.length; i++) {
                    new QRCode(elementos[i], {
                        text: elementos[i].getAttribute('data-value') || '',
                        width: 256,
                        height: 256,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }
                function ajustarCodigos() {
                    var codigos = document.querySelectorAll('.label-code');
                    for (var j = 0; j < codigos.length; j++) {
                        var texto = codigos[j].querySelector('.label-code-text');
                        var quantidade = parseInt(codigos[j].getAttribute('data-character-count'), 10) || 12;
                        var maximo = quantidade <= 9 ? 48 : quantidade === 10 ? 46 : quantidade === 11 ? 44 : 42;
                        var minimo = 24;
                        var larguraDisponivel = codigos[j].clientWidth - 2;
                        var alturaDisponivel = codigos[j].clientHeight - 2;

                        while (maximo - minimo > 0.25) {
                            var tentativa = (maximo + minimo) / 2;
                            texto.style.fontSize = tentativa.toFixed(2) + 'pt';
                            if (texto.scrollWidth <= larguraDisponivel && texto.scrollHeight <= alturaDisponivel) minimo = tentativa;
                            else maximo = tentativa;
                        }
                        texto.style.fontSize = minimo.toFixed(1) + 'pt';
                    }
                    botao.disabled = false;
                    botao.textContent = 'Imprimir ou salvar como PDF';
                    botao.onclick = function () { window.print(); };
                }

                if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(ajustarCodigos);
                } else {
                    ajustarCodigos();
                }
            } catch (e) {
                botao.textContent = 'Não foi possível gerar os QR Codes';
            }
        })();

        (function () {
            var botao = document.getElementById('btn-imprimir-direto');
            if (!botao) return;

            var status = document.getElementById('status-impressao-direta');
            botao.onclick = function () {
                var iframe = document.getElementById('direct-label-print-frame');
                var seletor = document.getElementById('printer-select');
                var impressora = seletor.options[seletor.selectedIndex];
                var servidorIp = document.getElementById('ps-ip').value.trim();
                var servidorPorta = document.getElementById('ps-port').value.trim();
                var impressoraNome = impressora.getAttribute('data-name') || impressora.textContent.trim();
                var impressoraIp = impressora.getAttribute('data-ip') || '';
                var impressoraPorta = impressora.getAttribute('data-port') || '';
                var zpl = document.getElementById('zpl-etiquetas').value;
                var finalizado = false;

                botao.disabled = true;
                seletor.disabled = true;
                status.textContent = 'Conectando ao servidor de impressão...';

                var timeoutId = window.setTimeout(function () {
                    if (finalizado) return;
                    finalizado = true;
                    botao.disabled = false;
                    seletor.disabled = false;
                    status.textContent = 'Não foi possível conectar ao servidor de impressão.';
                }, 30000);

                iframe.onload = function () {
                    window.setTimeout(function () {
                        if (finalizado) return;
                        try {
                            iframe.contentWindow.postMessage(JSON.stringify({
                                ipServidorImpressao: servidorIp,
                                portaServidorImpressao: servidorPorta,
                                nomeImpressora: impressoraNome,
                                ipImpressora: impressoraIp,
                                portaImpressora: impressoraPorta,
                                comandosZPL: zpl
                            }), '*');
                            finalizado = true;
                            window.clearTimeout(timeoutId);
                            botao.disabled = false;
                            seletor.disabled = false;
                            status.textContent = 'Etiquetas enviadas diretamente para a impressora.';
                        } catch (e) {
                            finalizado = true;
                            window.clearTimeout(timeoutId);
                            botao.disabled = false;
                            seletor.disabled = false;
                            status.textContent = 'Falha ao enviar as etiquetas para a impressora.';
                        }
                    }, 3000);
                };

                iframe.src = 'https://' + servidorIp + ':' + servidorPorta
                    + '/quasardealer/impressora/iframeImpressao?_=' + new Date().getTime();
            };
        })();
    </script>
</body>
</html>
