@{
    ViewBag.Title = "Estoque";
    ViewBag.Description = "Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime? ultimaAtualizacaoEstoque = ViewBag.UltimaAtualizacaoEstoque as DateTime?;
}

<link href="~/Content/jquery-filestyle/jquery-filestyle.min.css" rel="stylesheet" />

<style>
    div.jfilestyle.jfilestyle-theme-quasar input {
        border: none;
        background: #eee;
    }

    div.jfilestyle.jfilestyle-theme-quasar label {
        border: none;
        background: #3c8dbc;
        color: #fff;
    }

    .upload-summary {
        margin-top: 18px;
        text-align: left;
    }

    .upload-summary-table {
        width: 100%;
        margin-bottom: 14px;
        border-collapse: collapse;
    }

    .upload-summary-table th,
    .upload-summary-table td {
        padding: 9px 12px;
        border: 1px solid #dce5ec;
    }

    .upload-summary-table th {
        color: #26394d;
        background: #f2f7fa;
        text-align: center;
    }

    .upload-summary-table td:not(:first-child) {
        text-align: right;
    }

    .upload-summary-detail {
        margin: 0;
        color: #68798a;
        font-size: 13px;
        text-align: center;
    }

    .last-update {
        font-size: 14px !important;
        margin-top: 5px !important;
        margin-right: 10px !important;
    }
</style>

<section class="content-header">
    <h1>
        @ViewBag.Title<small>@ViewBag.Description</small>
        <small class="pull-right last-update">
            <i class="fa fa-clock-o fa-fw"></i>
            Última atualização:
            <span id="ultima-atualizacao-estoque">
                @(ultimaAtualizacaoEstoque.HasValue
                    ? ultimaAtualizacaoEstoque.Value.ToString("dd/MM/yyyy HH:mm:ss")
                    : "Não realizada")
            </span>
        </small>
    </h1>
</section>

<section class="content">
    <div class="box box-default">
        <div class="box-body">

            <div class="col-xs-12">
                <div class="form-group">
                    <label class="text-muted">Importar arquivo de atualização</label>
                    <div>
                        <input type="file" id="uploadestoque" class="jfilestyle"
                               data-theme="quasar"
                               data-text="<i class='fa-solid fa-folder'></i> Selecionar"
                               data-buttonBefore="true"
                               data-inputSize="300px"
                               data-placeholder="Nenhum arquivo selecionado">
                        <button type="button" id="btn-importar-estoque" class="btn btn-success hide" style="margin-left:5px">
                            <i class="fa fa-fw fa-upload"></i> Importar
                        </button>
                        <span id="msg-upload"></span>
                        <a href="#" data-url="@Url.Action("ConfigUpload","Upload", new { area="EstoqueApp"})" class="pull-right config" style="margin-right:10px"><i class="fa fa-fw fa-gear"></i> Configurar Upload</a>
                    </div>
                </div>
            </div>

            <div class="row processing hide">
                <div class="col-xs-12">
                    <p><i class="fa fa-fw fa-spinner fa-spin"></i> Loading...</p>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Modal  -->
<div class="modal fade" id="myModal" data-backdrop="static" tabindex="-1" aria-labelledby="myModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/Scripts/jquery-filestyle/jquery-filestyle.min.js"></script>

    <script>

        function bindForm(dialog) {
            $('form', dialog).submit(function () {
                $.ajax({
                    url: this.action,
                    type: this.method,
                    data: $(this).serialize(),
                    success: function (result) {
                        if (result.success) {
                            $('#myModal').modal('hide');
                        } else {
                            $('#myModalContent').html(result);
                            bindForm();
                        }
                    },
                    error: function (data) {
                        console.log('erro', data);
                    }
                });
                return false;
            });
        }

        function valorResumo(valor) {
            var numero = Number(valor);
            return isNaN(numero) ? 0 : numero;
        }

        function criarResumoUpload(response) {
            var conteudo = document.createElement("div");
            conteudo.className = "upload-summary";

            var titulo = document.createElement("h4");
            titulo.className = "swal-text-success";
            titulo.textContent = "Arquivo de estoque importado com sucesso!";
            conteudo.appendChild(titulo);

            var tabela = document.createElement("table");
            tabela.className = "upload-summary-table";
            tabela.innerHTML =
                "<thead><tr><th>Tabela</th><th>Criados</th><th>Atualizados</th></tr></thead>" +
                "<tbody>" +
                "<tr><td>Estoque</td><td>" + valorResumo(response.inseridos) + "</td><td>" + valorResumo(response.atualizados) + "</td></tr>" +
                "<tr><td>Material</td><td>" + valorResumo(response.materiais_inseridos) + "</td><td>" + valorResumo(response.materiais_atualizados) + "</td></tr>" +
                "<tr><td>Locação</td><td>" + valorResumo(response.locacoes_inseridas) + "</td><td>" + valorResumo(response.locacoes_atualizadas) + "</td></tr>" +
                "</tbody>";
            conteudo.appendChild(tabela);

            var detalhe = document.createElement("p");
            detalhe.className = "upload-summary-detail";
            detalhe.textContent =
                "Linhas lidas: " + valorResumo(response.qtd_linhas) +
                " | Processadas: " + valorResumo(response.processados) +
                " | Desconsideradas: " + valorResumo(response.desconsiderados);
            conteudo.appendChild(detalhe);

            return conteudo;
        }

        $(document).ready(function () {

            $('#uploadestoque').on('change', function (ev) {
                if ($(this).get(0).files.length === 0) {
                    $('#btn-importar-estoque').addClass('hide');
                    $('#check-estoque').addClass('hide');
                } else {
                    $('#btn-importar-estoque').removeClass('hide');
                    $('#check-estoque').removeClass('hide');
                    //var filename = $(this).val().replace(/.*(\/|\\)/, '');
                    //console.log(filename)
                }
            });

            $('#btn-importar-estoque').click(function (e) {
                e.preventDefault();

                if ($("#uploadestoque").val() != '') {
                    var msg = 'Confirma a importação do arquivo ?';

                    swal({
                        title: "Atualizar estoque",
                        text: "Confirma a importação do arquivo ?",
                        buttons: {
                            cancel: {
                                text: "Não",
                                className: "swal-btn-danger",
                                closeModal: true,
                                visible: true,
                            },
                            confirm: {
                                text: "Sim",
                                className: "swal-btn-success",
                                closeModal: true,
                                visible: true
                            }
                        }
                    }).then((confirm) => {
                        if (confirm) {
                            $('#btn-importar-estoque').html("<i class='fa fa-fw fa-pulse fa-spinner'></i> Importando arquivo...");

                            var fileUpload = $("#uploadestoque").get(0);
                            var files = fileUpload.files;

                            var form = new FormData();

                            //Add files
                            //for (var i = 0; i < files.length; i++) {
                            //    form.append("Arquivo", files[i]);
                            //}

                            form.append("Arquivo", files[0]);

                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("UploadFileEstoque", "Upload", new { area = "EstoqueApp" })',
                                contentType: false,
                                processData: false,
                                data: form,
                            }).done(function (response) {
                                $('#btn-importar-estoque').html("<i class='fa fa-fw fa-upload'></i> Importar");
                                if (response.erro == false) {
                                    if (response.atualizado_em) {
                                        $('#ultima-atualizacao-estoque').text(response.atualizado_em);
                                    }

                                    setTimeout(function () {
                                        swal({
                                            title: "Atualizar estoque",
                                            content: criarResumoUpload(response),
                                            buttons: {
                                                confirm: {
                                                    text: "OK",
                                                    className: "swal-btn-info"
                                                }
                                            }
                                        })

                                    }, 300);
                                } else {
                                    var div = document.createElement("div");
                                    div.innerHTML = "<h4 class='swal-text-error'>Não foi possível importar o arquivo selecionado!</h4><p class='swal-text-error-detail'>" + response.mensagem + "</p>";
                                    swal({
                                        title: "Atualizar estoque",
                                        content: div,
                                        buttons: {
                                            confirm: {
                                                visible: false
                                            },
                                            cancel: {
                                                text: "Fechar",
                                                className: "swal-btn-danger",
                                                closeModal: true,
                                                visible: true
                                            }
                                        }
                                    })
                                }
                            }).fail(function (jqXHR, textStatus, errorThrown) {
                                console.log(jqXHR, textStatus, errorThrown)
                                $('#btn-importar-estoque').html("<i class='fa fa-fw fa-upload'></i> Importar");
                                var div = document.createElement("div");
                                div.innerHTML = "<h4 class='swal-text-error'>Não foi possível importar o arquivo selecionado!</h4><p class='swal-text-error-detail'>" + jqXHR + "</p>";
                                swal({
                                    title: "Atualizar estoque",
                                    content: div,
                                    buttons: {
                                        confirm: {
                                            visible: false
                                        },
                                        cancel: {
                                            text: "Fechar",
                                            className: "swal-btn-danger",
                                            closeModal: true,
                                            visible: true
                                        }
                                    }
                                })
                            })
                        }
                    });
                }
            });

            $("a.config").click(function () {
                var url = $(this).attr('data-url');
                if (url) {
                    $('#myModalContent').load(url, function () {
                        $('#myModal').modal({
                            backdrop: 'static',
                            keyboard: true
                        }, 'show');
                        bindForm(this);
                    });
                    return false;
                }
            });

            $('#myModal').on('shown.bs.modal', function () {
                $('#Valor').focus();
            })

        });

    </script>
}
